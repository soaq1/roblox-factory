{
  "name": "roblox-factory",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Meshes": { "$path": "assets/Models.rbxm" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "$path": "src/materials"
    },
    "StarterPlayer": {
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "TextChatService": {
      "$properties": { "ChatVersion": "TextChatService" }
    },
    "Workspace": {
      "$properties": { "FallenPartsDestroyHeight": -300, "StreamingEnabled": false }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.55, 0.57, 0.6],
        "Brightness": 2.2,
        "ClockTime": 14,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.6, 0.62, 0.66]
      }
    }
  }
}
