      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">Stock</string>
          <string name="Source"><![CDATA[--!nocheck
-- What a bag can hold in the real (non-creative) game, and how the things placed in the world turn
-- into bag entries and back. A bag key is an item id, a machine id, or "block:<id>" for a block.
-- Takes the definitions as an argument so it can be tested outside Roblox:
--     local Stock = require(Shared.Stock)(Defs)
return function(Defs)
	local Stock = {}

	local BLOCK = "block:"
	-- Blocks that come apart into something else when broken, and are placed from that same thing.
	local BREAKS_INTO = { dirt = "dirt_clod" }

	Stock.SAPLING_CHANCE = 0.1 -- how often breaking leaves gives a sapling

	-- The block id inside a "block:<id>" key.
	function Stock.blockOf(key): string?
		if type(key) == "string" and string.sub(key, 1, #BLOCK) == BLOCK then
			local id = string.sub(key, #BLOCK + 1)
			return if Defs.Blocks[id] then id else nil
		end
		return nil
	end

	function Stock.isKey(key): boolean
		return Defs.isItem(key) or Defs.isMachine(key) or Stock.blockOf(key) ~= nil
	end

	function Stock.name(key): string
		local block = Stock.blockOf(key)
		if block then
			return Defs.Blocks[block].name .. " 블록"
		end
		return Defs.name(key)
	end

	-- What goes into the bag when a block is broken. `roll` is a random number from 0 up to 1.
	function Stock.blockDrop(id: string, roll: number): string?
		if id == "leaves" then
			return if roll < Stock.SAPLING_CHANCE then "sapling" else nil
		end
		if BREAKS_INTO[id] then
			return BREAKS_INTO[id]
		end
		-- A block that is also an item (log, stone, ore) comes back as the item.
		if Defs.Items[id] then
			return id
		end
		return BLOCK .. id
	end

	-- The bag keys that can pay for placing something, in the order they are tried.
	function Stock.placeCost(entry: string): { string }
		if Defs.Blocks[entry] then
			local keys = { BLOCK .. entry }
			if Defs.Items[entry] then
				table.insert(keys, entry)
			end
			if BREAKS_INTO[entry] then
				table.insert(keys, BREAKS_INTO[entry])
			end
			return keys
		end
		local machine = Defs.Machines[entry]
		if machine then
			return { machine.cost or entry }
		end
		return {}
	end

	-- What goes into the bag when a machine is broken. Plants give nothing here: what they yield
	-- depends on how far they have grown, and they drop that themselves.
	function Stock.machineReturn(id: string): string?
		local machine = Defs.Machines[id]
		if not machine or machine.cost then
			return nil
		end
		return id
	end

	return Stock
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">TradeLogic</string>
          <string name="Source"><![CDATA[--!strict
-- A trade between two players, "a" and "b". Each puts up items and coins and then marks themselves
-- ready. Changing anything un-readies both, so nobody can swap an offer after the other agreed.
-- Nothing moves until `complete`, which checks both sides again and then swaps everything at once.
local TradeLogic = {}

export type Bag = { [string]: number }
export type Side = { offer: Bag, coins: number, ready: boolean }
export type Session = { a: Side, b: Side, done: boolean }

TradeLogic.MAX_KINDS = 24 -- different things one side can put up
local LIMIT = 2 ^ 31
local MAX_COINS = 10 ^ 15

local function side(session: Session, who: any): Side?
	if who == "a" then
		return session.a
	elseif who == "b" then
		return session.b
	end
	return nil
end

local function unready(session: Session)
	session.a.ready = false
	session.b.ready = false
end

local function isWhole(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and n >= 0
end

function TradeLogic.new(): Session
	return {
		a = { offer = {}, coins = 0, ready = false },
		b = { offer = {}, coins = 0, ready = false },
		done = false,
	}
end

-- Sets how many of one thing a side puts up. Zero takes it off the table.
function TradeLogic.setOffer(session: Session, who: any, key: any, n: any, bag: Bag): (boolean, string?)
	local mine = side(session, who)
	if not mine or session.done then
		return false, "closed"
	end
	if type(key) ~= "string" or not isWhole(n) then
		return false, "amount"
	end
	if n > (bag[key] or 0) then
		return false, "missing"
	end
	if n > 0 and not mine.offer[key] then
		local kinds = 0
		for _ in mine.offer do
			kinds += 1
		end
		if kinds >= TradeLogic.MAX_KINDS then
			return false, "kinds"
		end
	end
	if n > 0 then
		mine.offer[key] = n
	else
		mine.offer[key] = nil
	end
	unready(session)
	return true, nil
end

function TradeLogic.setCoins(session: Session, who: any, n: any, balance: number): (boolean, string?)
	local mine = side(session, who)
	if not mine or session.done then
		return false, "closed"
	end
	if not isWhole(n) or n > MAX_COINS then
		return false, "amount"
	end
	if n > balance then
		return false, "missing"
	end
	mine.coins = n
	unready(session)
	return true, nil
end

function TradeLogic.setReady(session: Session, who: any, ready: any): boolean
	local mine = side(session, who)
	if not mine or session.done or type(ready) ~= "boolean" then
		return false
	end
	mine.ready = ready
	return true
end

function TradeLogic.isAgreed(session: Session): boolean
	return not session.done and session.a.ready and session.b.ready
end

local function holds(bag: Bag, balance: number, mine: Side): boolean
	if mine.coins > balance then
		return false
	end
	for key, n in mine.offer do
		if (bag[key] or 0) < n then
			return false
		end
	end
	return true
end

-- Would this bag overflow after giving `out` and receiving `inc`?
local function fits(bag: Bag, out: Bag, inc: Bag): boolean
	for key, n in inc do
		if (bag[key] or 0) - (out[key] or 0) + n >= LIMIT then
			return false
		end
	end
	return true
end

local function takeOut(bag: Bag, offer: Bag)
	for key, n in offer do
		local left = (bag[key] or 0) - n
		if left > 0 then
			bag[key] = left
		else
			bag[key] = nil
		end
	end
end

local function putIn(bag: Bag, offer: Bag)
	for key, n in offer do
		bag[key] = (bag[key] or 0) + n
	end
end

-- Swaps everything, if both are ready and both still hold what they put up. Returns the two new
-- coin balances. On failure nothing has moved; if what a side holds has changed since they
-- agreed, both are un-readied so they look again.
function TradeLogic.complete(
	session: Session,
	bagA: Bag,
	coinsA: number,
	bagB: Bag,
	coinsB: number
): (boolean, string?, number, number)
	if not TradeLogic.isAgreed(session) then
		return false, "unready", coinsA, coinsB
	end
	local a, b = session.a, session.b
	if not holds(bagA, coinsA, a) or not holds(bagB, coinsB, b) then
		unready(session)
		return false, "changed", coinsA, coinsB
	end
	local afterA = coinsA - a.coins + b.coins
	local afterB = coinsB - b.coins + a.coins
	if
		afterA > MAX_COINS
		or afterB > MAX_COINS
		or not fits(bagA, a.offer, b.offer)
		or not fits(bagB, b.offer, a.offer)
	then
		unready(session)
		return false, "full", coinsA, coinsB
	end
	-- Take both offers out before putting either in, so the same thing passing both ways is right.
	takeOut(bagA, a.offer)
	takeOut(bagB, b.offer)
	putIn(bagB, a.offer)
	putIn(bagA, b.offer)
	session.done = true
	return true, nil, afterA, afterB
end

return TradeLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">Wallet</string>
          <string name="Source"><![CDATA[--!strict
-- Coins. A balance is a whole number from 0 up to MAX; an amount moved is a whole number of at least 1.
local Wallet = {}

Wallet.MAX = 10 ^ 15 -- far below where whole numbers stop being exact

function Wallet.isAmount(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and n >= 1 and n <= Wallet.MAX
end

-- A stored balance, or `fallback` when what was stored is not a valid one.
function Wallet.sanitize(raw: any, fallback: number): number
	if type(raw) == "number" and raw == raw and raw % 1 == 0 and raw >= 0 and raw <= Wallet.MAX then
		return raw
	end
	return fallback
end

-- The balance after receiving n, or nil if n is not a valid amount or the balance would pass MAX.
function Wallet.add(balance: number, n: any): number?
	if not Wallet.isAmount(n) or balance + n > Wallet.MAX then
		return nil
	end
	return balance + n
end

-- The balance after paying n, or nil if n is not a valid amount or there is not enough.
function Wallet.spend(balance: number, n: any): number?
	if not Wallet.isAmount(n) or n > balance then
		return nil
	end
	return balance - n
end

return Wallet
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="104">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="105">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">Commands</string>
          <string name="Source"><![CDATA[-- Chat commands. Each is registered once and reached from both chat systems; when both report the
-- same message it only runs once.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Commands = {}

type Handler = (player: Player, args: { string }) -> ()

local handlers: { [string]: Handler } = {}
local last: { [Player]: { text: string, at: number } } = {}

local function run(player: Player, text: string)
	local words = string.split(string.gsub(text, "^%s+", ""), " ")
	local args = {}
	for i = 2, #words do
		if words[i] ~= "" then
			table.insert(args, words[i])
		end
	end
	local handler = handlers[string.lower(words[1] or "")]
	if not handler then
		return
	end
	local now = os.clock()
	local seen = last[player]
	if seen and seen.text == text and now - seen.at < 0.3 then
		return
	end
	last[player] = { text = text, at = now }
	local ok, err = pcall(handler, player, args)
	if not ok then
		warn("command " .. words[1] .. " failed: " .. tostring(err))
	end
end

function Commands.register(alias: string, handler: Handler)
	handlers["/" .. alias] = handler
	local cmd = Instance.new("TextChatCommand")
	cmd.Name = "Cmd" .. alias
	cmd.PrimaryAlias = "/" .. alias
	cmd.Triggered:Connect(function(source, text)
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			run(player, text)
		end
	end)
	cmd.Parent = TextChatService
end

function Commands.start()
	-- The older chat system does not run TextChatCommands, so listen there as well.
	local function watch(player: Player)
		player.Chatted:Connect(function(message)
			if string.sub(message, 1, 1) == "/" then
				run(player, message)
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
	end)
end

return Commands
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">CraftService</string>
          <string name="Source"><![CDATA[-- Crafting, hand work and workbench upgrades. The rules live in shared/CraftLogic; this module
-- works out which benches the player is standing near, runs the request against their bag, and
-- reports what happened.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CraftLogic = require(Shared.CraftLogic)
local Defs = require(Shared.Defs)
local Net = require(Shared.Net)
local Recipes = require(Shared.Recipes)
local IslandService = require(script.Parent.IslandService)
local MachineService = require(script.Parent.MachineService)
local Profile = require(script.Parent.Profile)
local RateLimit = require(script.Parent.RateLimit)

local CraftService = {}

local Stock = Profile.Stock

-- The name of each kind of bench, for messages.
local benchNames: { [string]: string } = { bag = "가방" }
for _, def in Defs.Machines do
	if def.behavior == "bench" then
		benchNames[def.bench] = def.name
	end
end

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

-- Which benches on the player's own island are within reach, and at what tier.
function CraftService.benchesNear(player: Player, island): CraftLogic.Benches
	local benches: CraftLogic.Benches = {}
	local position = rootPosition(player)
	if not position then
		return benches
	end
	for _, machine in MachineService.onIsland(island) do
		if
			machine.def.behavior == "bench"
			and (machine.center - position).Magnitude <= Config.BENCH_RANGE
		then
			local kind = machine.def.bench
			benches[kind] = math.max(benches[kind] or 0, island.tiers[kind] or 1)
		end
	end
	return benches
end

local function explain(reason: string?, detail: any): string
	if reason == "bench" then
		return (benchNames[detail] or tostring(detail)) .. " 가까이에서만 할 수 있습니다"
	elseif reason == "tier" then
		return "작업대 " .. tostring(detail) .. "단계가 필요합니다"
	elseif reason == "missing" then
		return Stock.name(detail) .. "이(가) 모자랍니다"
	elseif reason == "tool" then
		return Stock.name(detail) .. "이(가) 있어야 합니다"
	elseif reason == "fuel" then
		return "땔감이 모자랍니다"
	elseif reason == "full" then
		return "가방에 더 넣을 수 없습니다"
	elseif reason == "max" then
		return "이미 가장 높은 단계입니다"
	elseif reason == "kind" then
		return "그런 작업대는 없습니다"
	end
	return "개수가 올바르지 않습니다"
end

local function isIndex(index: any, list: { any }): boolean
	return type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #list
end

function CraftService.craft(player: Player, index: any, times: any)
	local island = IslandService.get(player)
	if not island or not isIndex(index, Recipes.craft) then
		return
	end
	local recipe = Recipes.craft[index]
	local ok, reason, detail =
		CraftLogic.craft(island.bag, recipe, CraftService.benchesNear(player, island), times)
	if ok then
		Profile.push(island)
		Profile.notify(
			player,
			Stock.name(recipe.out) .. " " .. recipe.n * times .. "개를 만들었습니다"
		)
	else
		Profile.notify(player, Stock.name(recipe.out) .. ": " .. explain(reason, detail))
	end
end

function CraftService.hand(player: Player, index: any, times: any)
	local island = IslandService.get(player)
	if not island or not isIndex(index, Recipes.hand) then
		return
	end
	local recipe = Recipes.hand[index]
	local benches = CraftService.benchesNear(player, island)
	local ok, reason, detail, fuel =
		CraftLogic.hand(island.bag, recipe, benches, times, Recipes.fuel, island.handFuel)
	island.handFuel = fuel
	if ok then
		local made = {}
		for key, n in recipe.outs do
			table.insert(made, Stock.name(key) .. " " .. n * times)
		end
		table.sort(made)
		Profile.push(island)
		Profile.notify(player, table.concat(made, ", ") .. "을(를) 만들었습니다")
	else
		Profile.notify(player, explain(reason, detail))
	end
end

function CraftService.upgrade(player: Player, kind: any)
	local island = IslandService.get(player)
	if not island then
		return
	end
	local benches = CraftService.benchesNear(player, island)
	local ok, reason, detail = CraftLogic.upgrade(island.bag, island.tiers, benches, kind, Recipes.upgrades)
	if ok then
		Profile.push(island)
		Profile.notify(
			player,
			benchNames[kind] .. "이(가) " .. island.tiers[kind] .. "단계가 되었습니다"
		)
	else
		Profile.notify(player, explain(reason, detail))
	end
end

-- The first recipe making `key` that can be made right now, else the first one making it at all.
function CraftService.findCraft(player: Player, key: string): number?
	local island = IslandService.get(player)
	if not island then
		return nil
	end
	local benches = CraftService.benchesNear(player, island)
	local first: number? = nil
	for index, recipe in Recipes.craft do
		if recipe.out == key then
			first = first or index
			if not CraftLogic.blocked(island.bag, recipe, benches, 1) then
				return index
			end
		end
	end
	return first
end

-- The same for hand work, trying each on a copy of the bag.
function CraftService.findHand(player: Player, key: string): number?
	local island = IslandService.get(player)
	if not island then
		return nil
	end
	local benches = CraftService.benchesNear(player, island)
	local first: number? = nil
	for index, recipe in Recipes.hand do
		if recipe.outs[key] then
			first = first or index
			if
				CraftLogic.hand(table.clone(island.bag), recipe, benches, 1, Recipes.fuel, island.handFuel)
			then
				return index
			end
		end
	end
	return first
end

-- Everything the player could craft once, right now, with what they hold and where they stand.
function CraftService.available(player: Player): { string }
	local island = IslandService.get(player)
	local names = {}
	if island then
		local benches = CraftService.benchesNear(player, island)
		local seen = {}
		for _, recipe in Recipes.craft do
			if not seen[recipe.out] and not CraftLogic.blocked(island.bag, recipe, benches, 1) then
				seen[recipe.out] = true
				table.insert(names, Stock.name(recipe.out))
			end
		end
	end
	table.sort(names)
	return names
end

function CraftService.start()
	local function guarded(run)
		return function(player: Player, ...)
			if RateLimit.allow(player) then
				run(player, ...)
			end
		end
	end
	Net.get("Craft").OnServerEvent:Connect(guarded(CraftService.craft))
	Net.get("Hand").OnServerEvent:Connect(guarded(CraftService.hand))
	Net.get("Upgrade").OnServerEvent:Connect(guarded(CraftService.upgrade))
end

return CraftService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">DebugService</string>
          <string name="Source"><![CDATA[-- Measurement tools for this test build: live numbers for the client to show, and chat commands.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Commands = require(script.Parent.Commands)
local ItemService = require(script.Parent.ItemService)
local MachineService = require(script.Parent.MachineService)
local Tuning = require(script.Parent.Tuning)

local DebugService = {}

local function setSpeed(text: string)
	local n = tonumber(string.match(text, "([%d%.]+)"))
	if n then
		Tuning.speed = math.clamp(n, 0.1, 50)
		Workspace:SetAttribute("DbgSpeed", Tuning.speed)
	end
end

local function clearItems()
	ItemService.clearWhere(function()
		return false
	end)
end

function DebugService.start()
	Workspace:SetAttribute("DbgSpeed", 1)
	Commands.register("speed", function(_player, args)
		setSpeed(args[1] or "")
	end)
	Commands.register("clear", clearItems)

	local beats, since = 0, os.clock()
	RunService.Heartbeat:Connect(function()
		beats += 1
		local now = os.clock()
		if now - since >= 1 then
			Workspace:SetAttribute("DbgHz", math.floor(beats / (now - since) + 0.5))
			Workspace:SetAttribute("DbgItems", ItemService.count())
			Workspace:SetAttribute("DbgMachines", MachineService.count())
			beats, since = 0, now
		end
	end)
end

return DebugService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">GameCommands</string>
          <string name="Source"><![CDATA[-- Chat commands for trying the real game's rules before there are screens for them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Inventory = require(Shared.Inventory)
local Commands = require(script.Parent.Commands)
local CraftService = require(script.Parent.CraftService)
local IslandService = require(script.Parent.IslandService)
local Profile = require(script.Parent.Profile)
local TradeService = require(script.Parent.TradeService)

local GameCommands = {}

local Stock = Profile.Stock

-- Things can be named by id ("ingot_fe", "block:planks") or by their Korean name without spaces.
local byName: { [string]: string } = {}
local function learn(key: string)
	byName[string.gsub(Stock.name(key), "%s", "")] = key
end
for id in Defs.Blocks do
	learn("block:" .. id)
end
for id in Defs.Machines do
	learn(id)
end
for id in Defs.Items do
	learn(id)
end

local function keyOf(word: string?): string?
	if not word then
		return nil
	end
	if Stock.isKey(word) then
		return word
	end
	return byName[word]
end

local function amount(word: string?, fallback: number): number
	local n = tonumber(word)
	return if n then math.floor(n) else fallback
end

local function findPlayer(name: string?): Player?
	if not name then
		return nil
	end
	local lower = string.lower(name)
	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lower or string.lower(player.DisplayName) == lower then
			return player
		end
	end
	return nil
end

function GameCommands.start()
	Commands.register("mode", function(player, args)
		local island = IslandService.get(player)
		local mode = args[1]
		if not island or not Config.ALLOW_MODE_SWITCH or (mode ~= "creative" and mode ~= "survival") then
			return
		end
		island.mode = mode
		Profile.push(island)
		Profile.notify(
			player,
			if mode == "survival"
				then "생존 모드: 가방에 있는 것만 놓을 수 있고, 부수면 가방으로 돌아옵니다"
				else "크리에이티브 모드: 무엇이든 무한히 놓을 수 있습니다"
		)
	end)

	-- Only in creative mode: puts anything straight into the bag.
	Commands.register("give", function(player, args)
		local island = IslandService.get(player)
		local key = keyOf(args[1])
		if not island or island.mode ~= "creative" then
			Profile.notify(player, "/give는 크리에이티브 모드에서만 됩니다")
			return
		end
		if key and Inventory.add(island.bag, key, amount(args[2], 1)) then
			Profile.push(island)
		else
			Profile.notify(player, "그런 것은 없습니다")
		end
	end)

	Commands.register("craft", function(player, args)
		local key = keyOf(args[1])
		local index = key and CraftService.findCraft(player, key)
		if index then
			CraftService.craft(player, index, amount(args[2], 1))
		else
			Profile.notify(player, "만드는 법이 없습니다")
		end
	end)

	Commands.register("hand", function(player, args)
		local key = keyOf(args[1])
		local index = key and CraftService.findHand(player, key)
		if index then
			CraftService.hand(player, index, amount(args[2], 1))
		else
			Profile.notify(player, "손으로 만드는 법이 없습니다")
		end
	end)

	Commands.register("upgrade", function(player, args)
		CraftService.upgrade(player, args[1])
	end)

	Commands.register("can", function(player)
		local names = CraftService.available(player)
		Profile.notify(
			player,
			if #names > 0
				then "지금 만들 수 있는 것: " .. table.concat(names, ", ")
				else "지금 만들 수 있는 것이 없습니다"
		)
	end)

	Commands.register("trade", function(player, args)
		local target = findPlayer(args[1])
		if target then
			TradeService.ask(player, target)
		else
			Profile.notify(player, "그런 플레이어가 없습니다")
		end
	end)
	Commands.register("offer", function(player, args)
		local key = keyOf(args[1])
		if key then
			TradeService.offer(player, key, amount(args[2], 1))
		else
			Profile.notify(player, "그런 것은 없습니다")
		end
	end)
	Commands.register("coins", function(player, args)
		TradeService.coins(player, amount(args[1], 0))
	end)
	Commands.register("ready", function(player)
		TradeService.ready(player, true)
	end)
	Commands.register("unready", function(player)
		TradeService.ready(player, false)
	end)
	Commands.register("cancel", function(player)
		TradeService.cancel(player)
	end)
end

return GameCommands
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">IslandService</string>
          <string name="Source"><![CDATA[-- One island per player: where it sits in the world and what is in each cell.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Grid = require(Shared.Grid)
local IslandGen = require(Shared.IslandGen)

local IslandService = {}

export type Cell = { kind: "block" | "machine", id: string, part: Instance?, machine: any? }
export type Island = {
	owner: Player,
	slot: number,
	origin: Vector3,
	folder: Folder,
	blocksFolder: Folder,
	machinesFolder: Folder,
	spawn: SpawnLocation,
	cells: { [string]: Cell },
	bag: { [string]: number },
	mode: string, -- "creative" or "survival"
	coins: number,
	tiers: { [string]: number }, -- workbench kind -> tier, for kinds raised above 1
	handFuel: number, -- heat left over from the last fire lit for hand work
	canSave: boolean,
}

local islands: { [Player]: Island } = {}
local slots: { [number]: Player } = {}

local CELL = Config.CELL
local BLOCK_SIZE = Vector3.new(CELL, CELL, CELL)

function IslandService.create(player: Player): Island
	local slot = 1
	while slots[slot] do
		slot += 1
	end
	slots[slot] = player

	local folder = Instance.new("Folder")
	folder.Name = "Island_" .. player.UserId
	local blocksFolder = Instance.new("Folder")
	blocksFolder.Name = "Blocks"
	blocksFolder.Parent = folder
	local machinesFolder = Instance.new("Folder")
	machinesFolder.Name = "Machines"
	machinesFolder.Parent = folder
	folder.Parent = Workspace

	-- A thin pad the player always arrives on. It is not a block, so it cannot be broken: even if
	-- the ground under it is dug away there is still somewhere to stand.
	local origin = Vector3.new(slot * Config.ISLAND_SPACING, 0, 0)
	local s = IslandGen.SPAWN
	local pad = Instance.new("SpawnLocation")
	pad.Name = "SpawnPad"
	pad.Anchored = true
	pad.Neutral = true
	pad.Duration = 0
	pad.Size = Vector3.new(CELL, 0.1, CELL)
	pad.Position = origin + Vector3.new(s.x * CELL, (s.y - 0.5) * CELL + 0.05, s.z * CELL)
	pad.Material = Enum.Material.SmoothPlastic
	pad.Color = Color3.fromRGB(228, 225, 219)
	pad.Transparency = 0.5
	pad.CanQuery = false -- the build cursor looks straight through it
	pad.Parent = folder
	player.RespawnLocation = pad

	local island: Island = {
		owner = player,
		slot = slot,
		origin = origin,
		folder = folder,
		blocksFolder = blocksFolder,
		machinesFolder = machinesFolder,
		spawn = pad,
		cells = {},
		bag = {},
		mode = Config.START_MODE,
		coins = Config.START_COINS,
		tiers = {},
		handFuel = 0,
		-- Stays false until the island has finished loading, so a half-built island is never saved
		-- over the real one.
		canSave = false,
	}
	islands[player] = island
	player:SetAttribute("IslandOrigin", island.origin)
	return island
end

function IslandService.get(player: Player): Island?
	return islands[player]
end

function IslandService.all(): { [Player]: Island }
	return islands
end

function IslandService.destroy(player: Player)
	local island = islands[player]
	if not island then
		return
	end
	islands[player] = nil
	slots[island.slot] = nil
	island.folder:Destroy()
end

function IslandService.cellCenter(island: Island, x: number, y: number, z: number): Vector3
	return island.origin + Vector3.new(x * CELL, y * CELL, z * CELL)
end

function IslandService.spawnCFrame(island: Island): CFrame
	local s = IslandGen.SPAWN
	return CFrame.new(IslandService.cellCenter(island, s.x, s.y, s.z) + Vector3.new(0, 2, 0))
end

-- Is this world position inside the stretch of world that belongs to the island?
function IslandService.owns(island: Island, position: Vector3): boolean
	return math.abs(position.X - island.origin.X) < Config.ISLAND_SPACING / 2
end

function IslandService.setBlock(island: Island, x: number, y: number, z: number, id: string): boolean
	local key = Grid.key(x, y, z)
	local def = Defs.Blocks[id]
	if island.cells[key] or not def then
		return false
	end
	local part = Instance.new("Part")
	part.Name = key
	part.Anchored = true
	part.Size = BLOCK_SIZE
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	part.Transparency = def.transparency
	part.Position = IslandService.cellCenter(island, x, y, z)
	-- Blocks whose top differs from their sides (grass, logs, farmland) get a thin cap.
	local top = def.top
	if
		math.abs(top[1] - def.color[1])
			+ math.abs(top[2] - def.color[2])
			+ math.abs(top[3] - def.color[3])
		> 60
	then
		local cap = Instance.new("Part")
		cap.Name = "Cap"
		cap.Anchored = true
		cap.CanCollide = false
		cap.CanQuery = false
		cap.CanTouch = false
		cap.Size = Vector3.new(CELL + 0.02, 0.45, CELL + 0.02)
		cap.Material = Enum.Material.SmoothPlastic
		cap.Color = Color3.fromRGB(top[1], top[2], top[3])
		cap.Position = part.Position + Vector3.new(0, CELL / 2 - 0.22, 0)
		cap.Parent = part
	end
	part.Parent = island.blocksFolder
	island.cells[key] = { kind = "block", id = id, part = part }
	return true
end

function IslandService.clearCell(island: Island, key: string)
	local cell = island.cells[key]
	if not cell then
		return
	end
	island.cells[key] = nil
	if cell.part then
		cell.part:Destroy()
	end
end

return IslandService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Loose items: real parts moved by the physics engine. Only the server makes or removes them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)

local ItemService = {}

local folder = Instance.new("Folder")
folder.Name = "Items"
folder.Parent = Workspace
ItemService.folder = folder

local PHYSICS = PhysicalProperties.new(1, 0.7, 0, 1, 1)
local REST_SPEED = 0.8 -- stacks only merge when both are nearly still, so items on a moving belt stay separate

local nextUid = 0
local queue: { BasePart } = {} -- oldest first, may contain parts that are already gone
local liveCount = 0

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = { folder }

local function isLive(part: Instance): boolean
	return part.Parent == folder and not part:GetAttribute("Dead")
end

local function kill(part: BasePart)
	if isLive(part) then
		part:SetAttribute("Dead", true)
		liveCount -= 1
		part:Destroy()
	end
end

local function refreshLabel(part: BasePart)
	local count = part:GetAttribute("Count") :: number
	local gui = part:FindFirstChild("Label") :: BillboardGui?
	if count <= 1 then
		if gui then
			gui:Destroy()
		end
		return
	end
	if not gui then
		local newGui = Instance.new("BillboardGui")
		newGui.Name = "Label"
		newGui.Size = UDim2.fromOffset(60, 22)
		newGui.StudsOffset = Vector3.new(0, 1.1, 0)
		newGui.MaxDistance = 70
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.3
		text.Font = Enum.Font.GothamBold
		text.TextSize = 16
		text.Parent = newGui
		newGui.Parent = part
		gui = newGui
	end
	local text = (gui :: BillboardGui):FindFirstChild("Text") :: TextLabel
	text.Text = "×" .. count
end

local function tryMerge(a: BasePart, b: BasePart)
	if not isLive(a) or not isLive(b) or a == b then
		return
	end
	if a:GetAttribute("ItemId") ~= b:GetAttribute("ItemId") then
		return
	end
	if a.AssemblyLinearVelocity.Magnitude > REST_SPEED or b.AssemblyLinearVelocity.Magnitude > REST_SPEED then
		return
	end
	local total = (a:GetAttribute("Count") :: number) + (b:GetAttribute("Count") :: number)
	if total > Config.MAX_STACK then
		return
	end
	-- The older stack survives, so two touching stacks always agree on who absorbs whom.
	local keep, gone = a, b
	if (b:GetAttribute("Uid") :: number) < (a:GetAttribute("Uid") :: number) then
		keep, gone = b, a
	end
	kill(gone)
	keep:SetAttribute("Count", total)
	refreshLabel(keep)
end

local function trim()
	while liveCount > Config.MAX_LOOSE_ITEMS and #queue > 0 do
		local oldest = table.remove(queue, 1) :: BasePart
		kill(oldest)
	end
	-- Drop entries for parts that were removed some other way, so the queue cannot grow without bound.
	if #queue > Config.MAX_LOOSE_ITEMS * 4 then
		local kept = {}
		for _, part in queue do
			if isLive(part) then
				table.insert(kept, part)
			end
		end
		queue = kept
	end
end

function ItemService.spawn(itemId: string, count: number, position: Vector3): BasePart?
	local def = Defs.Items[itemId]
	if not def or count < 1 then
		return nil
	end
	nextUid += 1
	local part = Instance.new("Part")
	part.Name = itemId
	if def.ball then
		part.Shape = Enum.PartType.Ball
	end
	part.Size = Vector3.new(def.size[1], def.size[2], def.size[3])
	part.Color = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	part.Material = Enum.Material.SmoothPlastic
	part.CustomPhysicalProperties = PHYSICS
	part.Position = position
	part:SetAttribute("ItemId", itemId)
	part:SetAttribute("Count", math.min(count, Config.MAX_STACK))
	part:SetAttribute("Uid", nextUid)
	part.Parent = folder
	-- The server keeps physics ownership so a client cannot move or teleport items.
	pcall(function()
		part:SetNetworkOwner(nil)
	end)
	part.Touched:Connect(function(other)
		if other.Parent == folder then
			tryMerge(part, other)
		end
	end)
	part.Destroying:Connect(function()
		if not part:GetAttribute("Dead") then
			-- Removed by the engine (fell out of the world) rather than by kill().
			part:SetAttribute("Dead", true)
			liveCount -= 1
		end
	end)
	liveCount += 1
	table.insert(queue, part)
	refreshLabel(part)
	trim()
	return part
end

-- Spawns any amount, split into full stacks.
function ItemService.spawnMany(itemId: string, count: number, position: Vector3)
	local i = 0
	while count > 0 do
		local n = math.min(count, Config.MAX_STACK)
		ItemService.spawn(itemId, n, position + Vector3.new(0, i * 0.9, 0))
		count -= n
		i += 1
	end
end

function ItemService.info(part: Instance): (string?, number)
	if not isLive(part) then
		return nil, 0
	end
	return part:GetAttribute("ItemId") :: string, part:GetAttribute("Count") :: number
end

-- Removes up to n items from a stack and returns how many were removed.
function ItemService.take(part: BasePart, n: number): number
	local _, count = ItemService.info(part)
	local taken = math.min(n, count)
	if taken <= 0 then
		return 0
	end
	if taken >= count then
		kill(part)
	else
		part:SetAttribute("Count", count - taken)
		refreshLabel(part)
	end
	return taken
end

function ItemService.inBox(cframe: CFrame, size: Vector3): { BasePart }
	return Workspace:GetPartBoundsInBox(cframe, size, overlap)
end

function ItemService.nearest(position: Vector3, range: number): BasePart?
	local best: BasePart? = nil
	local bestDistance = range
	for _, part in Workspace:GetPartBoundsInRadius(position, range, overlap) do
		local distance = (part.Position - position).Magnitude
		if isLive(part) and distance <= bestDistance then
			best, bestDistance = part, distance
		end
	end
	return best
end

-- Counts what is really there, which also corrects the running total if the engine removed anything.
-- Touched only fires at the moment two parts meet, when at least one is still moving. This sweep
-- catches stacks that have since come to rest side by side.
function ItemService.start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, child in folder:GetChildren() do
				if
					child:IsA("BasePart")
					and isLive(child)
					and child.AssemblyLinearVelocity.Magnitude <= REST_SPEED
				then
					local reach = child.Size + Vector3.new(0.15, 0.15, 0.15)
					for _, other in Workspace:GetPartBoundsInBox(child.CFrame, reach, overlap) do
						tryMerge(child, other)
						if not isLive(child) then
							break
						end
					end
				end
			end
		end
	end)
end

function ItemService.count(): number
	liveCount = #folder:GetChildren()
	return liveCount
end

function ItemService.clearWhere(keep: (BasePart) -> boolean)
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and not keep(child) then
			kill(child)
		end
	end
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="112">
        <Properties>
          <string name="Name">MachineKit</string>
          <string name="Source"><![CDATA[-- Shared pieces machines are assembled from.
-- A machine is built in its own frame: +X is forward (where things come out), Y is up, +Z is the
-- right-hand side, and the origin is the centre of its footprint at the height of a cell's centre.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ModelBuilder = require(Shared.ModelBuilder)

local MachineKit = {}

local CELL = Config.CELL

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

MachineKit.COLORS = {
	light = rgb(228, 225, 219),
	dark = rgb(72, 70, 67),
	belt = rgb(43, 42, 41),
	mark = rgb(110, 107, 102),
}
local C = MachineKit.COLORS

function MachineKit.base(center: Vector3, dir: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, -dir * math.pi / 2, 0)
end

function MachineKit.part(model: Instance, base: CFrame, size: Vector3, offset: Vector3, color: Color3): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.Size = size
	part.CFrame = base * CFrame.new(offset)
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Parent = model
	return part
end

-- A surface that carries whatever rests on it. `velocity` is in the machine's own frame.
function MachineKit.conveyor(
	model: Instance,
	base: CFrame,
	size: Vector3,
	offset: Vector3,
	velocity: Vector3
): Part
	local part = MachineKit.part(model, base, size, offset, C.belt)
	part.Name = "Conveyor"
	part.AssemblyLinearVelocity = base:VectorToWorldSpace(velocity)
	return part
end

-- Decoration that nothing bumps into and the build cursor ignores.
function MachineKit.detail(
	model: Instance,
	base: CFrame,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	turn: CFrame?
): Part
	local part = MachineKit.part(model, base, size, offset, color)
	if turn then
		part.CFrame *= turn
	end
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

-- The look of a catalogue model, built from basic parts.
function MachineKit.visual(model: Instance, base: CFrame, id: string): Folder?
	return ModelBuilder.build(model, base, id)
end

-- One unseen box the size of the machine. It is what players and items bump into, and what the
-- build cursor hits.
function MachineKit.body(machine): Part
	local def = machine.def
	local height = math.max(def.height, 1)
	local part = Instance.new("Part")
	part.Name = "Body"
	part.Anchored = true
	part.Transparency = 1
	part.CanCollide = not def.walkThrough
	part.Size = Vector3.new(def.sx * CELL - 0.1, height, def.sz * CELL - 0.1)
	part.CFrame = machine.base * CFrame.new(0, -CELL / 2 + height / 2, 0)
	part.Parent = machine.model
	machine.model:SetAttribute("Solid", true)
	return part
end

local SIDES = {
	E = Vector3.new(1, 0, 0),
	W = Vector3.new(-1, 0, 0),
	S = Vector3.new(0, 0, 1),
	N = Vector3.new(0, 0, -1),
}

export type Port = { kind: string, box: CFrame, size: Vector3, spawn: Vector3 }

-- Where things enter and leave. `box` is the space just outside a mouth: for an input, an item
-- resting there is taken in; for an output, it must be empty before the next item comes out.
function MachineKit.ports(machine): { Port }
	local def = machine.def
	local ports = {}
	for _, port in def.ports do
		local outward = SIDES[port.side]
		local alongX = port.side == "E" or port.side == "W"
		local half = (if alongX then def.sx else def.sz) * CELL / 2
		local lateral = if alongX
			then Vector3.new(0, 0, -port.off * CELL)
			else Vector3.new(port.off * CELL, 0, 0)
		local edge = outward * half + lateral
		table.insert(ports, {
			kind = port.kind,
			-- from the ground up to a little above belt height, so items on a belt or on the floor both count
			box = machine.base * CFrame.new(edge + outward * 0.45 + Vector3.new(0, -0.55, 0)),
			size = if alongX then Vector3.new(0.9, 1.9, 2.2) else Vector3.new(2.2, 1.9, 0.9),
			spawn = (machine.base * CFrame.new(edge + outward * 0.75 + Vector3.new(0, -0.15, 0))).Position,
		})
	end
	return ports
end

function MachineKit.inputs(ports: { Port }): { Port }
	local list = {}
	for _, port in ports do
		if port.kind == "in" then
			table.insert(list, port)
		end
	end
	return list
end

function MachineKit.outputs(ports: { Port }): { Port }
	local list = {}
	for _, port in ports do
		if port.kind == "out" then
			table.insert(list, port)
		end
	end
	return list
end

-- A small read-out above the machine, visible from close by.
function MachineKit.label(part: BasePart, height: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(190, 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 1.2, 0)
	gui.MaxDistance = 30
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextYAlignment = Enum.TextYAlignment.Bottom
	label.Text = ""
	label.Parent = gui
	gui.Parent = part
	return label
end

return MachineKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="113">
        <Properties>
          <string name="Name">MachineService</string>
          <string name="Source"><![CDATA[-- Keeps track of every placed machine and runs each one on a fixed beat.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Grid = require(Shared.Grid)
local IslandService = require(script.Parent.IslandService)
local ItemService = require(script.Parent.ItemService)
local Kit = require(script.Parent.MachineKit)

local MachineService = {}

-- Which file in server/machines runs each kind of behaviour.
local MODULES = {
	belt = "Belt",
	extractor = "Extractor",
	processor = "Processor",
	passthrough = "Passthrough",
	chest = "Chest",
	bench = "Bench",
	sapling = "Plant",
	crop = "Plant",
	decor = "Decor",
}

local machines: { [any]: boolean } = {}
local total = 0

local function moduleFor(behavior: string)
	local name = MODULES[behavior] or "Decor"
	return require(script.Parent.machines:FindFirstChild(name) :: ModuleScript) :: any
end

-- The keys of every cell a machine would cover, or nil if any of them is taken or out of range.
function MachineService.freeCells(
	island: IslandService.Island,
	id: string,
	x: number,
	y: number,
	z: number,
	dir: number
): { string }?
	local def = Defs.Machines[id]
	if not def then
		return nil
	end
	-- The anchor cell comes first; tall machines also keep the cells above them.
	local keys = {}
	for layer = 0, def.sy - 1 do
		for _, cell in Grid.footprint(x, z, dir, def.sx, def.sz) do
			if not Grid.inBounds(cell[1], y + layer, cell[2], Config.MAX_COORD) then
				return nil
			end
			local key = Grid.key(cell[1], y + layer, cell[2])
			if island.cells[key] then
				return nil
			end
			table.insert(keys, key)
		end
	end
	return keys
end

function MachineService.create(
	island: IslandService.Island,
	id: string,
	x: number,
	y: number,
	z: number,
	dir: number,
	saved: any?
)
	local def = Defs.Machines[id]
	local keys = MachineService.freeCells(island, id, x, y, z, dir)
	if not def or not keys then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = id
	model:SetAttribute("Machine", id)
	model:SetAttribute("CellX", x)
	model:SetAttribute("CellY", y)
	model:SetAttribute("CellZ", z)

	local cx, cz = Grid.footprintCentre(dir, def.sx, def.sz)
	local center = IslandService.cellCenter(island, x, y, z)
		+ Vector3.new(cx * Config.CELL, 0, cz * Config.CELL)
	local machine = {
		id = id,
		def = def,
		mod = moduleFor(def.behavior),
		island = island,
		key = Grid.key(x, y, z),
		keys = keys,
		x = x,
		y = y,
		z = z,
		dir = dir,
		model = model,
		center = center,
		base = Kit.base(center, dir),
	}
	-- Parent first: a conveyor's velocity is only reliable once the part is in the world.
	model.Parent = island.machinesFolder
	machine.mod.build(machine)
	if machine.mod.load and saved ~= nil then
		machine.mod.load(machine, saved)
	end

	machines[machine] = true
	total += 1
	for _, key in keys do
		island.cells[key] = { kind = "machine", id = id, machine = machine }
	end
	return machine
end

function MachineService.remove(machine, dropContents: boolean)
	if not machines[machine] then
		return
	end
	machines[machine] = nil
	total -= 1
	if dropContents and machine.mod.drops then
		for id, count in machine.mod.drops(machine) do
			if count > 0 then
				ItemService.spawnMany(id, count, machine.center + Vector3.new(0, 1, 0))
			end
		end
	end
	for _, key in machine.keys do
		machine.island.cells[key] = nil
	end
	machine.model:Destroy()
end

function MachineService.removeIsland(island: IslandService.Island)
	for machine in machines do
		if machine.island == island then
			MachineService.remove(machine, false)
		end
	end
end

function MachineService.onIsland(island: IslandService.Island): { any }
	local list = {}
	for machine in machines do
		if machine.island == island then
			table.insert(list, machine)
		end
	end
	return list
end

function MachineService.saveState(machine): any?
	if machine.mod.save then
		return machine.mod.save(machine)
	end
	return nil
end

function MachineService.count(): number
	return total
end

function MachineService.start()
	local carried = 0
	RunService.Heartbeat:Connect(function(dt)
		carried += dt
		if carried < Config.MACHINE_TICK then
			return
		end
		-- After a long stall, run one beat rather than trying to catch up all at once.
		local step = math.min(carried, Config.MACHINE_TICK * 3)
		carried = 0
		local finished = {}
		for machine in machines do
			local tick = machine.mod.tick
			if tick then
				local ok, result = pcall(tick, machine, step)
				if not ok then
					warn("machine " .. machine.id .. " at " .. machine.key .. " failed: " .. tostring(result))
				elseif result == true then
					table.insert(finished, machine)
				end
			end
		end
		-- A machine that says it is done (a sapling that has grown) is removed, then gets to leave
		-- something behind.
		for _, machine in finished do
			MachineService.remove(machine, false)
			if machine.mod.finish then
				local ok, err = pcall(machine.mod.finish, machine)
				if not ok then
					warn("machine " .. machine.id .. " could not finish: " .. tostring(err))
				end
			end
		end
	end)
end

return MachineService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="114">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Start-up: bring the services up, then give each arriving player an island.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local IslandGen = require(Shared.IslandGen)
local Net = require(Shared.Net)
local Commands = require(script.Parent.Commands)
local CraftService = require(script.Parent.CraftService)
local DebugService = require(script.Parent.DebugService)
local GameCommands = require(script.Parent.GameCommands)
local IslandService = require(script.Parent.IslandService)
local ItemService = require(script.Parent.ItemService)
local MachineService = require(script.Parent.MachineService)
local PlacementService = require(script.Parent.PlacementService)
local Profile = require(script.Parent.Profile)
local SaveService = require(script.Parent.SaveService)
local TradeService = require(script.Parent.TradeService)

local BATCH = 400 -- blocks built before letting the server breathe
local FALL_DEPTH = 90 -- studs below the island at which a falling player is brought back

local function buildStarter(island: IslandService.Island)
	for _, b in IslandGen.generate() do
		IslandService.setBlock(island, b.x, b.y, b.z, b.id)
	end
end

-- Returns false if the player left while the island was still being built.
local function buildSaved(player: Player, island: IslandService.Island, saved): boolean
	for i, b in saved.blocks do
		IslandService.setBlock(island, b.x, b.y, b.z, b.id)
		if i % BATCH == 0 then
			task.wait()
			if IslandService.get(player) ~= island then
				return false
			end
		end
	end
	for _, m in saved.machines do
		MachineService.create(island, m.id, m.x, m.y, m.z, m.d, m.s)
	end
	Profile.load(island, saved.bag, saved.profile)
	return true
end

local function putOnIsland(player: Player, island: IslandService.Island)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character and root and root:IsA("BasePart") then
		character:PivotTo(IslandService.spawnCFrame(island))
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

-- Characters do not load on their own in this game (the island has to exist first), so this loop
-- owns the player's body: it loads one when there is none or it has died, and brings back anyone
-- who has fallen off the island.
local function keepCharacter(player: Player, island: IslandService.Island)
	local deadSince: number? = nil
	while IslandService.get(player) == island do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local alive = character ~= nil and character.Parent ~= nil and humanoid ~= nil and humanoid.Health > 0

		if not alive then
			local since = deadSince or os.clock()
			deadSince = since
			if os.clock() - since >= 2 or character == nil then
				deadSince = nil
				-- LoadCharacter waits until the body is placed, so moving it afterwards sticks.
				local ok = pcall(player.LoadCharacter, player)
				if ok and IslandService.get(player) == island then
					putOnIsland(player, island)
				end
			end
		else
			deadSince = nil
			if root and root:IsA("BasePart") and root.Position.Y < island.origin.Y - FALL_DEPTH then
				putOnIsland(player, island)
			end
		end
		task.wait(0.5)
	end
end

local function onPlayerAdded(player: Player)
	local island = IslandService.create(player)
	local result = SaveService.load(player)
	if IslandService.get(player) ~= island then
		return -- left while loading; PlayerRemoving has already cleaned up
	end

	if result.status == "loaded" and result.island then
		if not buildSaved(player, island, result.island) then
			return
		end
		-- If anything in the stored island could not be read, do not save this session: writing
		-- back would erase the unreadable parts for good.
		island.canSave = result.skipped == 0
		if result.skipped > 0 then
			Net.get("Notify"):FireClient(
				player,
				"저장된 섬에서 읽을 수 없는 항목이 "
					.. result.skipped
					.. "개 있습니다. 이번 접속은 저장되지 않습니다."
			)
		end
	else
		buildStarter(island)
		if result.status == "new" then
			island.canSave = true
		else
			Net.get("Notify"):FireClient(
				player,
				"저장된 섬을 불러오지 못했습니다. 이번 접속은 저장되지 않습니다."
			)
		end
	end

	Profile.push(island)
	keepCharacter(player, island)
end

local function onPlayerRemoving(player: Player)
	local island = IslandService.get(player)
	if not island then
		return
	end
	SaveService.save(player)
	MachineService.removeIsland(island)
	ItemService.clearWhere(function(part)
		return not IslandService.owns(island, part.Position)
	end)
	IslandService.destroy(player)
end

Commands.start()
ItemService.start()
MachineService.start()
PlacementService.start()
CraftService.start()
TradeService.start()
SaveService.start()
DebugService.start()
GameCommands.start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="115">
        <Properties>
          <string name="Name">Outlet</string>
          <string name="Source"><![CDATA[-- How a finished item leaves a machine. Normally it drops just outside the mouth, onto a belt or the
-- ground. When another machine stands right against the mouth there is no room to drop anything,
-- so the item is handed straight over if that machine has an input facing this way.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ItemService = require(script.Parent.ItemService)

local Outlet = {}

local CELL = Config.CELL
local FACING = 1.7 -- studs between this mouth's drop point and a neighbour's input for them to count as joined

local function facingInput(other, port): boolean
	for _, input in other.ins or {} do
		if (input.box.Position - port.spawn).Magnitude < FACING then
			return true
		end
	end
	return false
end

-- Tries to put one item out through a port. Returns true if it left the machine.
function Outlet.emit(machine, port, id: string): boolean
	local island = machine.island
	local origin = island.origin
	local key = Grid.key(
		Grid.toCell(port.spawn.X, origin.X, CELL),
		Grid.toCell(port.spawn.Y, origin.Y, CELL),
		Grid.toCell(port.spawn.Z, origin.Z, CELL)
	)
	local cell = island.cells[key]
	if cell then
		if cell.kind == "block" then
			return false
		end
		local other = cell.machine
		if other ~= machine and other.model:GetAttribute("Solid") and not other.def.walkThrough then
			if other.mod.accept and facingInput(other, port) then
				return other.mod.accept(other, id, 1) == 1
			end
			return false
		end
	end
	-- Wait while the last item is still sitting at the mouth, so a blocked line backs up instead of piling.
	if #ItemService.inBox(port.box, port.size) > 0 then
		return false
	end
	return ItemService.spawn(id, 1, port.spawn) ~= nil
end

return Outlet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">PlacementService</string>
          <string name="Source"><![CDATA[-- Handles requests to place, break and pick up. Nothing a client sends is trusted:
-- every request is checked for type, range, ownership and rate before anything changes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Grid = require(Shared.Grid)
local Inventory = require(Shared.Inventory)
local Net = require(Shared.Net)
local IslandService = require(script.Parent.IslandService)
local ItemService = require(script.Parent.ItemService)
local MachineService = require(script.Parent.MachineService)
local Profile = require(script.Parent.Profile)
local RateLimit = require(script.Parent.RateLimit)

local PlacementService = {}

local Stock = Profile.Stock
local allowed = RateLimit.allow

-- In survival mode, the bag key that will pay for placing `entry`, or nil if the bag has none.
-- In creative mode nothing is paid, and this returns false.
local function payment(island: IslandService.Island, entry: string): (string | boolean)?
	if island.mode ~= "survival" then
		return false
	end
	for _, key in Stock.placeCost(entry) do
		if (island.bag[key] or 0) >= 1 then
			return key
		end
	end
	return nil
end

local function settle(island: IslandService.Island, key: string | boolean)
	if type(key) == "string" then
		Inventory.remove(island.bag, key, 1)
		Profile.push(island)
	end
end

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

-- Returns the island when the player may edit this cell.
local function editable(player: Player, x: any, y: any, z: any): IslandService.Island?
	if not allowed(player) then
		return nil
	end
	if not (Grid.isInt(x) and Grid.isInt(y) and Grid.isInt(z)) then
		return nil
	end
	if not Grid.inBounds(x, y, z, Config.MAX_COORD) then
		return nil
	end
	local island = IslandService.get(player)
	local position = rootPosition(player)
	if not island or not position then
		return nil
	end
	local center = IslandService.cellCenter(island, x, y, z)
	if (center - position).Magnitude > Config.REACH + Config.CELL then
		return nil
	end
	return island
end

-- Some things only go on particular ground: a sapling on grass or dirt, a crop on farmland.
local function groundAllows(island: IslandService.Island, def, x: number, y: number, z: number): boolean
	if not def.needsBelow then
		return true
	end
	local below = island.cells[Grid.key(x, y - 1, z)]
	return below ~= nil and below.kind == "block" and table.find(def.needsBelow, below.id) ~= nil
end

local function place(player: Player, id: any, x: any, y: any, z: any, dir: any)
	local island = editable(player, x, y, z)
	if not island or not Defs.isPlaceable(id) then
		return
	end
	local cost = payment(island, id)
	if cost == nil then
		Net.get("Notify"):FireClient(player, "가방에 " .. Defs.name(id) .. "이(가) 없습니다")
		return
	end
	if Defs.isBlock(id) then
		if not island.cells[Grid.key(x, y, z)] and IslandService.setBlock(island, x, y, z, id) then
			settle(island, cost)
		end
		return
	end
	local def = Defs.Machines[id]
	if def.hidden or not Grid.isDir(dir) then
		return
	end
	if not groundAllows(island, def, x, y, z) then
		local names = {}
		for _, below in def.needsBelow do
			table.insert(names, Defs.name(below))
		end
		Net.get("Notify"):FireClient(
			player,
			def.name .. ": " .. table.concat(names, "이나 ") .. " 위에만 놓을 수 있습니다"
		)
		return
	end
	-- create() refuses if any cell of the footprint is taken or out of range
	if MachineService.create(island, id, x, y, z, dir, nil) then
		settle(island, cost)
	end
end

-- Creative mode: drops a few loose items of any kind into an empty cell.
local function drop(player: Player, id: any, x: any, y: any, z: any)
	local island = editable(player, x, y, z)
	if not island or not Defs.isItem(id) then
		return
	end
	local cell = island.cells[Grid.key(x, y, z)]
	if cell and (cell.kind == "block" or cell.machine.model:GetAttribute("Solid")) then
		return
	end
	-- Creative mode makes the items from nothing; otherwise they come out of the bag.
	local count = Config.DROP_COUNT
	if island.mode == "survival" then
		count = math.min(count, island.bag[id] or 0)
		if count < 1 or not Inventory.remove(island.bag, id, count) then
			return
		end
		Profile.push(island)
	end
	ItemService.spawn(id, count, IslandService.cellCenter(island, x, y, z))
end

local function breakCell(player: Player, x: any, y: any, z: any)
	local island = editable(player, x, y, z)
	if not island then
		return
	end
	local key = Grid.key(x, y, z)
	local cell = island.cells[key]
	if not cell then
		return
	end
	-- In survival mode what is broken goes back into the bag.
	local back: string? = nil
	if cell.kind == "machine" then
		back = Stock.machineReturn(cell.id)
		MachineService.remove(cell.machine, true)
	else
		back = Stock.blockDrop(cell.id, math.random())
		IslandService.clearCell(island, key)
	end
	if island.mode == "survival" and back then
		Inventory.add(island.bag, back, 1)
		Profile.push(island)
	end
end

local function pickup(player: Player)
	local island = IslandService.get(player)
	local position = rootPosition(player)
	if not island or not position or not allowed(player) then
		return
	end
	local part = ItemService.nearest(position, Config.PICKUP_RANGE)
	if not part then
		return
	end
	local id, count = ItemService.info(part)
	if id then
		Inventory.add(island.bag, id, ItemService.take(part, count))
		Profile.push(island)
	end
end

function PlacementService.start()
	Net.get("Place").OnServerEvent:Connect(place)
	Net.get("Break").OnServerEvent:Connect(breakCell)
	Net.get("Drop").OnServerEvent:Connect(drop)
	Net.get("Pickup").OnServerEvent:Connect(pickup)
end

return PlacementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[-- What a player owns apart from the island itself: the bag, coins, workbench tiers and play mode.
-- This module tells the client when any of it changes and reads it back from stored data.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CraftLogic = require(Shared.CraftLogic)
local Defs = require(Shared.Defs)
local Inventory = require(Shared.Inventory)
local Net = require(Shared.Net)
local Wallet = require(Shared.Wallet)
local Stock = require(Shared.Stock)(Defs)

local Profile = {}

Profile.Stock = Stock

function Profile.push(island)
	local player = island.owner
	Net.get("Bag"):FireClient(player, island.bag)
	Net.get("State"):FireClient(player, { mode = island.mode, coins = island.coins, tiers = island.tiers })
end

function Profile.notify(player: Player, text: string)
	Net.get("Notify"):FireClient(player, text)
end

-- Fills an island's owner data from what was stored, falling back to a fresh start for any part
-- that is missing or not valid.
function Profile.load(island, bag: any, stored: any)
	island.bag = Inventory.sanitize(bag, Stock.isKey)
	if type(stored) ~= "table" then
		return
	end
	island.coins = Wallet.sanitize(stored.coins, Config.START_COINS)
	island.tiers = CraftLogic.sanitizeTiers(stored.tiers)
	if stored.mode == "creative" or stored.mode == "survival" then
		island.mode = stored.mode
	end
	if type(stored.fuel) == "number" and stored.fuel == stored.fuel then
		island.handFuel = math.clamp(math.floor(stored.fuel), 0, 64)
	end
end

function Profile.save(island): { [string]: any }
	return {
		mode = island.mode,
		coins = island.coins,
		tiers = table.clone(island.tiers),
		fuel = island.handFuel,
	}
end

return Profile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="118">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[-- A small allowance per player that refills over time. Requests beyond it are dropped.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local RateLimit = {}

local buckets: { [Player]: { tokens: number, at: number } } = {}

function RateLimit.allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = Config.RATE_PER_SECOND, at = now }
		buckets[player] = bucket
	end
	bucket.tokens =
		math.min(Config.RATE_PER_SECOND, bucket.tokens + (now - bucket.at) * Config.RATE_PER_SECOND)
	bucket.at = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[-- Saving and loading islands. Uses Roblox's data store when it is available, and a store that only
-- lasts while the server runs when it is not (an unpublished place opened in Studio).
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Codec = require(Shared.Codec)
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Grid = require(Shared.Grid)
local IslandService = require(script.Parent.IslandService)
local MachineService = require(script.Parent.MachineService)
local Profile = require(script.Parent.Profile)

local SaveService = {}

local STORE_NAME = "island_v1"
-- In Studio a failure almost always means the data store is switched off, so do not wait and retry.
local ATTEMPTS = if RunService:IsStudio() then 1 else 3
local CHECKS: Codec.Checks =
	{ isBlock = Defs.isBlock, isMachine = Defs.isMachine, maxCoord = Config.MAX_COORD }

local memory: { [string]: any } = {}
local useMemory = false

local function setMode()
	Workspace:SetAttribute("SaveMode", if useMemory then "임시" else "저장소")
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function attempt<T>(fn: () -> T): (boolean, T | string)
	local lastError = "unknown"
	for try = 1, ATTEMPTS do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = tostring(result)
		if try < ATTEMPTS then
			task.wait(try)
		end
	end
	return false, lastError
end

export type LoadResult = {
	status: "new" | "loaded" | "unreadable" | "failed",
	island: Codec.Island?,
	skipped: number,
}

function SaveService.load(player: Player): LoadResult
	local key = keyFor(player)
	local raw: any
	if useMemory then
		raw = memory[key]
	else
		local ok, result = attempt(function()
			return DataStoreService:GetDataStore(STORE_NAME):GetAsync(key)
		end)
		if ok then
			raw = result
		elseif RunService:IsStudio() then
			-- Studio without data store access: keep going with memory so the game is still testable.
			warn("data store unavailable, using a temporary store: " .. tostring(result))
			useMemory = true
			setMode()
			raw = memory[key]
		else
			warn("could not load island for " .. player.Name .. ": " .. tostring(result))
			return { status = "failed", island = nil, skipped = 0 }
		end
	end
	if raw == nil then
		return { status = "new", island = nil, skipped = 0 }
	end
	local island, skipped = Codec.decode(raw, CHECKS)
	if not island then
		return { status = "unreadable", island = nil, skipped = 0 }
	end
	return { status = "loaded", island = island, skipped = skipped }
end

local function snapshot(island: IslandService.Island): { [string]: any }
	local data: Codec.Island =
		{ blocks = {}, machines = {}, bag = table.clone(island.bag), profile = Profile.save(island) }
	for key, cell in island.cells do
		local x, y, z = Grid.parseKey(key)
		if x and y and z then
			if cell.kind == "block" then
				table.insert(data.blocks, { x = x, y = y, z = z, id = cell.id })
			elseif cell.machine.key == key then
				-- a machine that covers several cells is saved once, at its anchor cell
				table.insert(data.machines, {
					id = cell.id,
					x = x,
					y = y,
					z = z,
					d = cell.machine.dir,
					s = MachineService.saveState(cell.machine),
				})
			end
		end
	end
	return Codec.encode(data)
end

function SaveService.save(player: Player): boolean
	local island = IslandService.get(player)
	-- An island whose stored copy could not be read is never written back, so the original is kept.
	if not island or not island.canSave then
		return false
	end
	local key = keyFor(player)
	local data = snapshot(island)
	if useMemory then
		memory[key] = data
		return true
	end
	local ok, err = attempt(function()
		DataStoreService:GetDataStore(STORE_NAME):SetAsync(key, data)
		return true
	end)
	if not ok then
		warn("could not save island for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function SaveService.start()
	setMode()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for player in IslandService.all() do
				task.spawn(SaveService.save, player)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in IslandService.all() do
			pending += 1
			task.spawn(function()
				SaveService.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return SaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[-- Trades between two players on the same server. The rules live in shared/TradeLogic; this module
-- pairs players up, feeds their requests in, and moves the goods when both have agreed.
-- One player asks; the trade opens when the other asks back.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local TradeLogic = require(Shared.TradeLogic)
local IslandService = require(script.Parent.IslandService)
local Profile = require(script.Parent.Profile)
local RateLimit = require(script.Parent.RateLimit)

local TradeService = {}

local Stock = Profile.Stock

type Open = { session: TradeLogic.Session, a: Player, b: Player }

local asked: { [Player]: Player } = {} -- who each player has asked
local open: { [Player]: Open } = {}

local function describe(side: TradeLogic.Side): string
	local parts = {}
	for key, n in side.offer do
		table.insert(parts, Stock.name(key) .. " " .. n)
	end
	table.sort(parts)
	if side.coins > 0 then
		table.insert(parts, side.coins .. "코인")
	end
	local text = if #parts > 0 then table.concat(parts, ", ") else "없음"
	return text .. (if side.ready then " (준비됨)" else "")
end

-- Shows both players where the trade stands.
local function show(trade: Open)
	local s = trade.session
	local snapshot = {
		a = { name = trade.a.Name, offer = s.a.offer, coins = s.a.coins, ready = s.a.ready },
		b = { name = trade.b.Name, offer = s.b.offer, coins = s.b.coins, ready = s.b.ready },
	}
	local text = trade.a.Name .. ": " .. describe(s.a) .. "\n" .. trade.b.Name .. ": " .. describe(s.b)
	for _, player in { trade.a, trade.b } do
		Net.get("Trade"):FireClient(player, snapshot)
		Profile.notify(player, text)
	end
end

local function close(trade: Open, message: string?)
	for _, player in { trade.a, trade.b } do
		if open[player] == trade then
			open[player] = nil
		end
		if player.Parent then
			Net.get("Trade"):FireClient(player, nil)
			if message then
				Profile.notify(player, message)
			end
		end
	end
end

local function whoIn(trade: Open, player: Player): string
	return if trade.a == player then "a" else "b"
end

local function finish(trade: Open)
	local islandA, islandB = IslandService.get(trade.a), IslandService.get(trade.b)
	if not islandA or not islandB then
		close(trade, "거래가 취소되었습니다")
		return
	end
	local ok, reason, coinsA, coinsB =
		TradeLogic.complete(trade.session, islandA.bag, islandA.coins, islandB.bag, islandB.coins)
	if ok then
		islandA.coins, islandB.coins = coinsA, coinsB
		Profile.push(islandA)
		Profile.push(islandB)
		close(trade, "거래가 끝났습니다")
	elseif reason == "full" then
		show(trade)
		Profile.notify(trade.a, "받는 쪽 가방이나 지갑이 넘칩니다")
		Profile.notify(trade.b, "받는 쪽 가방이나 지갑이 넘칩니다")
	else
		show(trade)
		Profile.notify(trade.a, "내놓은 것이 바뀌어 다시 확인이 필요합니다")
		Profile.notify(trade.b, "내놓은 것이 바뀌어 다시 확인이 필요합니다")
	end
end

function TradeService.ask(player: Player, target: any)
	if typeof(target) ~= "Instance" or not target:IsA("Player") or target == player then
		return
	end
	if not IslandService.get(player) or not IslandService.get(target) then
		return
	end
	if open[player] or open[target] then
		Profile.notify(player, "이미 거래 중입니다")
		return
	end
	if asked[target] == player then
		asked[target] = nil
		asked[player] = nil
		local trade: Open = { session = TradeLogic.new(), a = target, b = player }
		open[player] = trade
		open[target] = trade
		show(trade)
		return
	end
	asked[player] = target
	Profile.notify(player, target.Name .. "님에게 거래를 청했습니다")
	Profile.notify(
		target,
		player.Name .. "님이 거래를 청했습니다. 받으려면 /trade " .. player.Name
	)
end

function TradeService.offer(player: Player, key: any, n: any)
	local trade, island = open[player], IslandService.get(player)
	if not trade or not island or not Stock.isKey(key) then
		return
	end
	local ok, reason = TradeLogic.setOffer(trade.session, whoIn(trade, player), key, n, island.bag)
	if ok then
		show(trade)
	else
		Profile.notify(
			player,
			if reason == "missing"
				then "그만큼 가지고 있지 않습니다"
				else "올릴 수 없습니다"
		)
	end
end

function TradeService.coins(player: Player, n: any)
	local trade, island = open[player], IslandService.get(player)
	if not trade or not island then
		return
	end
	local ok, reason = TradeLogic.setCoins(trade.session, whoIn(trade, player), n, island.coins)
	if ok then
		show(trade)
	else
		Profile.notify(
			player,
			if reason == "missing" then "코인이 모자랍니다" else "올릴 수 없습니다"
		)
	end
end

function TradeService.ready(player: Player, ready: any)
	local trade = open[player]
	if not trade or not TradeLogic.setReady(trade.session, whoIn(trade, player), ready) then
		return
	end
	if TradeLogic.isAgreed(trade.session) then
		finish(trade)
	else
		show(trade)
	end
end

function TradeService.cancel(player: Player)
	asked[player] = nil
	local trade = open[player]
	if trade then
		close(trade, player.Name .. "님이 거래를 취소했습니다")
	end
end

function TradeService.start()
	local actions = {
		ask = TradeService.ask,
		offer = TradeService.offer,
		coins = TradeService.coins,
		ready = TradeService.ready,
		cancel = TradeService.cancel,
	}
	Net.get("TradeAct").OnServerEvent:Connect(function(player: Player, action: any, a: any, b: any)
		local run = type(action) == "string" and actions[action]
		if run and RateLimit.allow(player) then
			run(player, a, b)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		for asker, target in asked do
			if asker == player or target == player then
				asked[asker] = nil
			end
		end
		local trade = open[player]
		if trade then
			close(trade, "상대가 나가서 거래가 취소되었습니다")
		end
	end)
end

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">Tuning</string>
          <string name="Source"><![CDATA[-- Values the debug commands change while the game runs.
return {
	speed = 1, -- how many times faster than normal extractors and plants run
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="122">
        <Properties>
          <string name="Name">machines</string>
        </Properties>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">Belt</string>
            <string name="Source"><![CDATA[-- Belts carry anything that touches them. There is no code moving the items: the surface has a
-- velocity and the physics engine does the rest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Kit = require(script.Parent.Parent.MachineKit)

local Belt = {}
local C = Kit.COLORS

local function chevron(model: Instance, base: CFrame, x: number, z: number, heading: number)
	local at = base * CFrame.new(x, -0.69, z) * CFrame.Angles(0, -heading, 0)
	for _, side in { -1, 1 } do
		Kit.detail(
			model,
			at,
			Vector3.new(0.7, 0.03, 0.14),
			Vector3.new(0, 0, side * 0.22),
			C.mark,
			CFrame.Angles(0, side * math.rad(42), 0)
		)
	end
end

function Belt.build(machine)
	local model, base = machine.model, machine.base
	local speed = Config.BELT_SPEED
	local shape = machine.def.shape
	Kit.part(model, base, Vector3.new(3, 0.6, 3), Vector3.new(0, -1.2, 0), C.dark)

	if shape == "straight" then
		Kit.conveyor(
			model,
			base,
			Vector3.new(3, 0.2, 2.35),
			Vector3.new(0, -0.8, 0),
			Vector3.new(speed, 0, 0)
		)
		for _, z in { -1.3, 1.3 } do
			Kit.part(model, base, Vector3.new(3, 0.6, 0.25), Vector3.new(0, -0.6, z), C.light)
		end
		chevron(model, base, 0, 0, 0)
	elseif shape == "open" then
		-- No side rails: items can roll on from either side and are carried forward. Two angled
		-- guides at the front funnel them back to the width of the next belt.
		Kit.conveyor(model, base, Vector3.new(3, 0.2, 3), Vector3.new(0, -0.8, 0), Vector3.new(speed, 0, 0))
		for _, z in { -1, 1 } do
			local guide =
				Kit.part(model, base, Vector3.new(1.25, 0.6, 0.2), Vector3.new(0.9, -0.6, z * 1.34), C.light)
			guide.CFrame *= CFrame.Angles(0, z * math.rad(15.2), 0)
			chevron(model, base, -0.2, z, 0)
		end
		chevron(model, base, 0, 0, 0)
	else
		-- Enters travelling forward, leaves to the right (+Z) or left (-Z). The surface pushes
		-- diagonally and the two outer walls turn that into a clean corner.
		local side = if shape == "right" then 1 else -1
		local push = speed * 0.7071
		Kit.conveyor(
			model,
			base,
			Vector3.new(3, 0.2, 3),
			Vector3.new(0, -0.8, 0),
			Vector3.new(push, 0, side * push)
		)
		Kit.part(model, base, Vector3.new(0.25, 0.6, 3), Vector3.new(1.3, -0.6, 0), C.light)
		Kit.part(model, base, Vector3.new(2.675, 0.6, 0.25), Vector3.new(-0.1625, -0.6, -side * 1.3), C.light)
		Kit.part(model, base, Vector3.new(0.3, 0.6, 0.3), Vector3.new(-1.35, -0.6, side * 1.35), C.light)
		chevron(model, base, -0.6, 0, 0)
		chevron(model, base, 0, side * 0.6, side * math.pi / 2)
	end
end

return Belt
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">Bench</string>
            <string name="Source"><![CDATA[-- Workbenches and hand stations. They do nothing by themselves: standing near one is what lets a
-- player craft that kind of thing. A workbench's tier belongs to the island, so every bench of a
-- kind shows the same tier.
local Kit = require(script.Parent.Parent.MachineKit)

local Bench = {}

local TIERED =
	{ basic = true, tool = true, part = true, machine = true, cook = true, elec = true, furn = true }

local function text(machine): string
	local kind = machine.def.bench
	if TIERED[kind] then
		return machine.def.name .. " " .. (machine.island.tiers[kind] or 1) .. "단계"
	end
	return machine.def.name
end

function Bench.build(machine)
	Kit.visual(machine.model, machine.base, machine.id)
	local body = Kit.body(machine)
	machine.label = Kit.label(body, machine.def.height)
	machine.shown = text(machine)
	machine.label.Text = machine.shown
end

function Bench.tick(machine, _dt: number)
	local now = text(machine)
	if now ~= machine.shown then
		machine.shown = now
		machine.label.Text = now
	end
end

return Bench
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">Chest</string>
            <string name="Source"><![CDATA[-- The storage unit: collects whatever arrives at its input. The owner empties it into their bag.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Inventory = require(Shared.Inventory)
local Net = require(Shared.Net)
local Kit = require(script.Parent.Parent.MachineKit)
local ItemService = require(script.Parent.Parent.ItemService)

local Chest = {}

local function refresh(machine)
	local lines = {}
	for id, count in machine.state do
		table.insert(lines, Defs.name(id) .. " " .. count)
	end
	table.sort(lines)
	machine.label.Text = if #lines > 0 then table.concat(lines, "\n") else "비어 있음"
	machine.prompt.Enabled = #lines > 0
end

function Chest.build(machine)
	Kit.visual(machine.model, machine.base, machine.id)
	local body = Kit.body(machine)
	machine.ins = Kit.inputs(Kit.ports(machine))
	machine.label = Kit.label(body, machine.def.height)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "꺼내기"
	prompt.ObjectText = machine.def.name
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		if player ~= machine.island.owner then
			return
		end
		for id, count in machine.state do
			Inventory.add(machine.island.bag, id, count)
		end
		table.clear(machine.state)
		refresh(machine)
		Net.get("Bag"):FireClient(player, machine.island.bag) -- only the bag changed
	end)

	machine.prompt = prompt
	machine.state = {}
	refresh(machine)
end

function Chest.load(machine, saved)
	machine.state = Inventory.sanitize(saved, Defs.isItem)
	refresh(machine)
end

function Chest.save(machine)
	return table.clone(machine.state)
end

function Chest.tick(machine, _dt: number)
	local changed = false
	for _, port in machine.ins do
		for _, part in ItemService.inBox(port.box, port.size) do
			local id, count = ItemService.info(part)
			if id then
				Inventory.add(machine.state, id, ItemService.take(part, count))
				changed = true
			end
		end
	end
	if changed then
		refresh(machine)
	end
end

-- Called when a neighbouring machine hands an item straight over.
function Chest.accept(machine, id: string, n: number): number
	Inventory.add(machine.state, id, n)
	refresh(machine)
	return n
end

function Chest.drops(machine): { [string]: number }
	return table.clone(machine.state)
end

return Chest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[-- Machines that are in the catalogue but do nothing yet. They can be placed and looked at.
local Kit = require(script.Parent.Parent.MachineKit)

local Decor = {}

function Decor.build(machine)
	Kit.visual(machine.model, machine.base, machine.id)
	Kit.body(machine)
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">Extractor</string>
            <string name="Source"><![CDATA[-- Puts out one raw item at a steady pace: ore from a vein core, water from a pump.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Kit = require(script.Parent.Parent.MachineKit)
local Outlet = require(script.Parent.Parent.Outlet)
local Tuning = require(script.Parent.Parent.Tuning)

local Extractor = {}

function Extractor.build(machine)
	Kit.visual(machine.model, machine.base, machine.id)
	Kit.body(machine)
	machine.out = Kit.outputs(Kit.ports(machine))[1]
	machine.timer = 0
end

function Extractor.tick(machine, dt: number)
	local out = machine.out
	if not out then
		return
	end
	machine.timer = math.min(machine.timer + dt * Tuning.speed, Config.EXTRACT_INTERVAL)
	if machine.timer >= Config.EXTRACT_INTERVAL and Outlet.emit(machine, out, machine.def.item) then
		machine.timer = 0
	end
end

return Extractor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">Passthrough</string>
            <string name="Source"><![CDATA[-- Machines that move items on without changing them: the splitter, merger, funnel and magnet
-- separator. Each holds one item at a time.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local Kit = require(script.Parent.Parent.MachineKit)
local ItemService = require(script.Parent.Parent.ItemService)
local Outlet = require(script.Parent.Parent.Outlet)

local Passthrough = {}

function Passthrough.build(machine)
	local def = machine.def
	Kit.visual(machine.model, machine.base, machine.id)
	Kit.body(machine)
	local ports = Kit.ports(machine)
	machine.ins = Kit.inputs(ports)
	machine.outs = Kit.outputs(ports)
	machine.nextIn = 1
	machine.nextOut = 1
	machine.held = nil
	if def.topIntake then
		-- A funnel also takes whatever lands in its open top.
		table.insert(machine.ins, {
			kind = "in",
			box = machine.base * CFrame.new(0, -Config.CELL / 2 + def.height + 0.3, 0),
			size = Vector3.new(2.4, 1.0, 2.4),
			spawn = Vector3.zero,
		})
	end
	machine.filter = {}
	for _, id in def.filter or {} do
		machine.filter[id] = true
	end
end

function Passthrough.load(machine, saved)
	if type(saved) == "table" and Defs.isItem(saved.held) then
		machine.held = saved.held
	end
end

function Passthrough.save(machine)
	return { held = machine.held }
end

-- Called when a neighbouring machine hands an item straight over.
function Passthrough.accept(machine, id: string, _n: number): number
	if machine.held then
		return 0
	end
	machine.held = id
	return 1
end

-- Takes one item from the inputs in turn, so one busy input cannot starve the others.
local function pull(machine)
	local count = #machine.ins
	for step = 0, count - 1 do
		local index = (machine.nextIn - 1 + step) % count + 1
		local input = machine.ins[index]
		for _, part in ItemService.inBox(input.box, input.size) do
			local id = ItemService.info(part)
			if id and ItemService.take(part, 1) == 1 then
				machine.held = id
				machine.nextIn = index % count + 1
				return
			end
		end
	end
end

-- With a filter, matching items take the second mouth and the rest the first. Without one, items
-- take the mouths in turn, skipping any that is blocked.
local function push(machine, id: string): boolean
	local outs = machine.outs
	if #outs > 1 and next(machine.filter) then
		return Outlet.emit(machine, if machine.filter[id] then outs[2] else outs[1], id)
	end
	for step = 0, #outs - 1 do
		local index = (machine.nextOut - 1 + step) % #outs + 1
		if Outlet.emit(machine, outs[index], id) then
			machine.nextOut = index % #outs + 1
			return true
		end
	end
	return false
end

function Passthrough.tick(machine, _dt: number)
	if #machine.outs == 0 then
		return
	end
	if not machine.held and #machine.ins > 0 then
		pull(machine)
	end
	if machine.held and push(machine, machine.held) then
		machine.held = nil
	end
end

function Passthrough.drops(machine): { [string]: number }
	return if machine.held then { [machine.held] = 1 } else {}
end

return Passthrough
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">Plant</string>
            <string name="Source"><![CDATA[-- Things that grow: a sapling becomes a tree of blocks, a crop ripens through stages.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local IslandGen = require(Shared.IslandGen)
local IslandService = require(script.Parent.Parent.IslandService)
local Kit = require(script.Parent.Parent.MachineKit)
local Tuning = require(script.Parent.Parent.Tuning)

local Plant = {}

local function stageOf(machine): number
	local stages = machine.def.stages
	if not stages then
		return 1
	end
	return math.clamp(math.floor(machine.age / Config.CROP_SECONDS * (#stages - 1)) + 1, 1, #stages)
end

local function show(machine, stage: number)
	if machine.visual then
		machine.visual:Destroy()
	end
	local stages = machine.def.stages
	machine.stage = stage
	machine.visual = Kit.visual(machine.model, machine.base, if stages then stages[stage] else machine.id)
end

function Plant.build(machine)
	machine.age = 0
	show(machine, 1)
	Kit.body(machine)
end

function Plant.load(machine, saved)
	if type(saved) == "table" and type(saved.age) == "number" and saved.age == saved.age then
		machine.age = math.clamp(saved.age, 0, 100000)
		local stage = stageOf(machine)
		if stage ~= machine.stage then
			show(machine, stage)
		end
	end
end

function Plant.save(machine)
	return { age = math.floor(machine.age) }
end

-- Returning true asks the machine service to remove this plant and then call `finish`.
function Plant.tick(machine, dt: number): boolean
	machine.age += dt * Tuning.speed
	if machine.def.behavior == "sapling" then
		return machine.age >= Config.SAPLING_SECONDS
	end
	local stage = stageOf(machine)
	if stage ~= machine.stage then
		show(machine, stage)
	end
	return false
end

-- A grown sapling leaves a tree where it stood. Cells that are already taken are skipped.
function Plant.finish(machine)
	local blocks = {}
	IslandGen.tree(blocks, machine.x, machine.y, machine.z, 3)
	for _, b in blocks do
		IslandService.setBlock(machine.island, b.x, b.y, b.z, b.id)
	end
end

function Plant.drops(machine): { [string]: number }
	if machine.def.behavior == "sapling" then
		return { sapling = 1 }
	end
	local stages = machine.def.stages
	if stages and machine.stage == #stages then
		return { wheat = 2, seed = 1 }
	end
	return { seed = 1 }
end

return Plant
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">Processor</string>
            <string name="Source"><![CDATA[-- Any machine that turns things into other things: smelter, crusher, press, kiln and the rest.
-- What it accepts and makes comes from the recipe table, so adding a recipe needs no code.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Defs = require(Shared.Defs)
local ProcessLogic = require(Shared.ProcessLogic)
local Recipes = require(Shared.Recipes)
local Kit = require(script.Parent.Parent.MachineKit)
local ItemService = require(script.Parent.Parent.ItemService)
local Outlet = require(script.Parent.Parent.Outlet)

local Processor = {}

local function describe(machine): string
	local state = machine.state
	local parts = {}
	for id, n in state.buf do
		table.insert(parts, Defs.name(id) .. " " .. n)
	end
	table.sort(parts)
	local text = table.concat(parts, " · ")
	if machine.rules.usesFuel then
		text ..= (if text == "" then "" else "\n") .. "연료 " .. state.fuel
	end
	return text
end

function Processor.build(machine)
	Kit.visual(machine.model, machine.base, machine.id)
	local body = Kit.body(machine)
	local ports = Kit.ports(machine)
	machine.ins = Kit.inputs(ports)
	machine.outs = Kit.outputs(ports)
	machine.nextOut = 1
	machine.rules = {
		recipes = Recipes.byMachine[machine.id] or {},
		usesFuel = Recipes.usesFuel[machine.id] == true,
		fuel = Recipes.fuel,
		cap = Config.MACHINE_BUFFER,
		outCap = Config.MACHINE_OUT,
	}
	machine.state = ProcessLogic.new()
	machine.label = Kit.label(body, machine.def.height)
	machine.shown = ""
end

function Processor.load(machine, saved)
	machine.state = ProcessLogic.sanitize(saved, machine.rules, Defs.isItem)
end

function Processor.save(machine)
	local s = machine.state
	return { buf = table.clone(s.buf), out = table.clone(s.out), fuel = s.fuel }
end

function Processor.tick(machine, dt: number)
	local state, rules = machine.state, machine.rules
	for _, port in machine.ins do
		for _, part in ItemService.inBox(port.box, port.size) do
			local id, count = ItemService.info(part)
			if id then
				local wanted = math.min(count, ProcessLogic.room(state, id, rules))
				if wanted > 0 then
					ProcessLogic.insert(state, id, ItemService.take(part, wanted), rules)
				end
			end
		end
	end

	ProcessLogic.step(state, dt, rules)

	local ready = ProcessLogic.peekOutput(state)
	if ready and #machine.outs > 0 then
		if Outlet.emit(machine, machine.outs[machine.nextOut], ready) then
			ProcessLogic.removeOutput(state, ready)
		end
		machine.nextOut = machine.nextOut % #machine.outs + 1
	end

	local text = describe(machine)
	if text ~= machine.shown then
		machine.shown = text
		machine.label.Text = text
	end
end

-- Called when a neighbouring machine hands an item straight over.
function Processor.accept(machine, id: string, n: number): number
	return ProcessLogic.insert(machine.state, id, n, machine.rules)
end

-- What falls out when the machine is broken.
function Processor.drops(machine): { [string]: number }
	local all = table.clone(machine.state.buf)
	for id, n in machine.state.out do
		all[id] = (all[id] or 0) + n
	end
	return all
end

return Processor
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="131">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="132">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="133">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">BuildController</string>
            <string name="Source"><![CDATA[-- Turns mouse and keyboard input into place, break and pick-up requests, and draws the outline
-- showing where the next thing will go. The server decides whether each request is allowed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Defs = require(Shared:WaitForChild("Defs"))
local Grid = require(Shared:WaitForChild("Grid"))
local Net = require(Shared:WaitForChild("Net"))

local BuildController = {}

local player = Players.LocalPlayer
local CELL = Config.CELL
local CLICK_SECONDS = 0.35 -- a right press longer than this, or that moves, is a camera drag
local CLICK_PIXELS = 8
local FREE = Color3.fromRGB(120, 220, 140)
local BLOCKED = Color3.fromRGB(230, 90, 80)

local hotbar
local dir = 0
local ghost: Part
local arrow: Part
local rightDownAt: number? = nil
local rightDragged = 0 -- pixels the mouse travelled while the right button was held

local keys = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

local function origin(): Vector3?
	local value = player:GetAttribute("IslandOrigin")
	return if typeof(value) == "Vector3" then value else nil
end

local function cellCenter(at: Vector3, x: number, y: number, z: number): Vector3
	return at + Vector3.new(x * CELL, y * CELL, z * CELL)
end

local function ignoreList(): { Instance }
	local list: { Instance } = { ghost, arrow }
	if player.Character then
		table.insert(list, player.Character)
	end
	local items = Workspace:FindFirstChild("Items")
	if items then
		table.insert(list, items)
	end
	return list
end

-- Snaps a surface normal to the nearest axis, as whole-number steps.
local function axisStep(normal: Vector3): (number, number, number)
	local ax, ay, az = math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z)
	if ay >= ax and ay >= az then
		return 0, math.sign(normal.Y), 0
	elseif ax >= az then
		return math.sign(normal.X), 0, 0
	end
	return 0, 0, math.sign(normal.Z)
end

export type Target = { bx: number, by: number, bz: number, px: number, py: number, pz: number }

-- What the cursor points at on my island: the cell that would be broken (b) and the empty
-- neighbour a new thing would go into (p).
local function target(): Target?
	local at = origin()
	local camera = Workspace.CurrentCamera
	local island = Workspace:FindFirstChild("Island_" .. player.UserId)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not at or not camera or not island or not root or not root:IsA("BasePart") then
		return nil
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList()
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 400, params)
	if not hit or not hit.Instance:IsDescendantOf(island) then
		return nil
	end

	-- The cell that was hit, and the step from it to the neighbour a new thing would go into.
	local inside = hit.Position - hit.Normal * 0.1
	local hx = Grid.toCell(inside.X, at.X, CELL)
	local hy = Grid.toCell(inside.Y, at.Y, CELL)
	local hz = Grid.toCell(inside.Z, at.Z, CELL)
	local sx, sy, sz = axisStep(hit.Normal)
	local bx, by, bz = hx, hy, hz
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	local def = model and Defs.Machines[model:GetAttribute("Machine") :: any]
	if model and def then
		-- A machine is broken by its anchor cell, whichever part of it was hit. Its shape does not
		-- fill its cells exactly, so the hit height is fitted to the layers the machine keeps.
		bx = model:GetAttribute("CellX") :: number
		by = model:GetAttribute("CellY") :: number
		bz = model:GetAttribute("CellZ") :: number
		if sy > 0 then
			hy = by + def.sy - 1
		elseif sy < 0 then
			hy = by
		else
			hy = math.clamp(hy, by, by + def.sy - 1)
		end
	end
	local found: Target = { bx = bx, by = by, bz = bz, px = hx + sx, py = hy + sy, pz = hz + sz }
	if (cellCenter(at, found.px, found.py, found.pz) - root.Position).Magnitude > Config.REACH then
		return nil
	end
	return found
end

local function isOccupied(box: CFrame, size: Vector3): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList()
	return #Workspace:GetPartBoundsInBox(box, size - Vector3.new(0.4, 0.4, 0.4), params) > 0
end

local function makeGhost()
	ghost = Instance.new("Part")
	ghost.Name = "BuildGhost"
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanQuery = false
	ghost.CanTouch = false
	ghost.Size = Vector3.new(CELL, CELL, CELL) * 0.98
	ghost.Material = Enum.Material.SmoothPlastic
	ghost.Transparency = 1
	ghost.Parent = Workspace

	arrow = Instance.new("Part")
	arrow.Name = "BuildArrow"
	arrow.Anchored = true
	arrow.CanCollide = false
	arrow.CanQuery = false
	arrow.CanTouch = false
	arrow.Size = Vector3.new(1.6, 0.2, 0.5)
	arrow.Material = Enum.Material.Neon
	arrow.Color = Color3.new(1, 1, 1)
	arrow.Transparency = 1
	arrow.Parent = Workspace
end

local function drawGhost()
	local at = origin()
	local found = if hotbar.isPaletteOpen() then nil else target()
	if not at or not found then
		ghost.Transparency = 1
		arrow.Transparency = 1
		return
	end
	local center = cellCenter(at, found.px, found.py, found.pz)
	local def = Defs.Machines[hotbar.selected()]
	local box, size = CFrame.new(center), Vector3.new(CELL, CELL, CELL)
	if def then
		-- A machine's outline covers every cell it will take. The aimed cell is its back-left corner.
		local cx, cz = Grid.footprintCentre(dir, def.sx, def.sz)
		box = CFrame.new(center + Vector3.new(cx * CELL, (def.sy - 1) * CELL / 2, cz * CELL))
			* CFrame.Angles(0, -dir * math.pi / 2, 0)
		size = Vector3.new(def.sx * CELL, def.sy * CELL, def.sz * CELL)
	end
	ghost.Size = size * 0.98
	ghost.CFrame = box
	ghost.Color = if isOccupied(box, size) then BLOCKED else FREE
	ghost.Transparency = 0.6
	if def then
		-- The arrow points the way things will come out.
		arrow.CFrame = box * CFrame.new(size.X / 2 - 0.8, size.Y / 2 + 0.1, 0)
		arrow.Transparency = 0
	else
		arrow.Transparency = 1
	end
end

local function onInputBegan(input: InputObject, handledByUi: boolean)
	if handledByUi then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local found = if hotbar.isPaletteOpen() then nil else target()
		if found then
			Net.get("Break"):FireServer(found.bx, found.by, found.bz)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		rightDownAt = os.clock()
		rightDragged = 0
	elseif input.KeyCode == Enum.KeyCode.R then
		dir = Grid.rotate(dir, 1)
	elseif input.KeyCode == Enum.KeyCode.E then
		hotbar.togglePalette()
	elseif input.KeyCode == Enum.KeyCode.F then
		Net.get("Pickup"):FireServer()
	elseif keys[input.KeyCode] then
		hotbar.select(keys[input.KeyCode])
	end
end

local function onInputEnded(input: InputObject)
	if input.UserInputType ~= Enum.UserInputType.MouseButton2 or not rightDownAt then
		return
	end
	local held = os.clock() - rightDownAt
	rightDownAt = nil
	if held > CLICK_SECONDS or rightDragged > CLICK_PIXELS or hotbar.isPaletteOpen() then
		return
	end
	local found = target()
	if not found then
		return
	end
	local entry = hotbar.selected()
	local item = Defs.itemOf(entry)
	if item then
		Net.get("Drop"):FireServer(item, found.px, found.py, found.pz)
	else
		Net.get("Place"):FireServer(entry, found.px, found.py, found.pz, dir)
	end
end

-- While the right button is held Roblox pins the cursor to turn the camera, so the cursor position
-- does not change. The movement has to be added up from the raw deltas instead.
local function onInputChanged(input: InputObject)
	if rightDownAt and input.UserInputType == Enum.UserInputType.MouseMovement then
		rightDragged += Vector2.new(input.Delta.X, input.Delta.Y).Magnitude
	end
end

function BuildController.init(hotbarUi)
	hotbar = hotbarUi
	makeGhost()
	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	UserInputService.InputChanged:Connect(onInputChanged)
	RunService.RenderStepped:Connect(drawGhost)
end

return BuildController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">DebugUI</string>
            <string name="Source"><![CDATA[-- Shows the server's live numbers in the corner of the screen.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local DebugUI = {}

function DebugUI.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DebugUI"
	gui.ResetOnSpawn = false
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 0.35
	text.BackgroundColor3 = Color3.fromRGB(28, 30, 34)
	text.BorderSizePixel = 0
	text.Position = UDim2.fromOffset(10, 10)
	text.Size = UDim2.fromOffset(200, 96)
	text.Font = Enum.Font.Code
	text.TextSize = 14
	text.TextColor3 = Color3.fromRGB(233, 234, 236)
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Text = ""
	text.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.Parent = text
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	task.spawn(function()
		while true do
			local function read(name: string): string
				local value = Workspace:GetAttribute(name)
				return if value == nil then "-" else tostring(value)
			end
			text.Text = string.format(
				"서버   %s 회/초\n물체   %s\n기계   %s\n추출   %s 배속\n저장   %s",
				read("DbgHz"),
				read("DbgItems"),
				read("DbgMachines"),
				read("DbgSpeed"),
				read("SaveMode")
			)
			task.wait(0.5)
		end
	end)
end

return DebugUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">HotbarUI</string>
            <string name="Source"><![CDATA[-- The nine quick slots, the creative palette, and the bag read-out.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Defs = require(Shared:WaitForChild("Defs"))
local ModelBuilder = require(Shared:WaitForChild("ModelBuilder"))
local Net = require(Shared:WaitForChild("Net"))
local Stock = require(Shared:WaitForChild("Stock"))(Defs)

local HotbarUI = {}

local SLOT = 70
local TILE = 96
local BACK = Color3.fromRGB(28, 30, 34)
local PANEL = Color3.fromRGB(36, 39, 44)
local LINE = Color3.fromRGB(70, 76, 85)
local TEXT = Color3.fromRGB(233, 234, 236)
local DIM = Color3.fromRGB(154, 160, 168)
local PICK = Color3.fromRGB(240, 180, 41)

local slots = table.clone(Defs.DefaultHotbar)
local selected = 1
local slotFrames: { Frame } = {}
local palette: Frame
local groupList: ScrollingFrame
local tileGrid: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local currentTab = Defs.Tabs[1]
local bagLabel: TextLabel
local stateLabel: TextLabel
local toast: TextLabel
local toastToken = 0

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function round(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function label(parent: Instance, text: string, size: number): TextLabel
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Font = Enum.Font.GothamMedium
	item.TextSize = size
	item.TextColor3 = TEXT
	item.TextWrapped = true
	item.Text = text
	item.Parent = parent
	return item
end

local function button(parent: Instance, text: string, size: number): TextButton
	local item = Instance.new("TextButton")
	item.AutoButtonColor = false
	item.BackgroundColor3 = PANEL
	item.BorderSizePixel = 0
	item.Font = Enum.Font.GothamMedium
	item.TextSize = size
	item.TextColor3 = TEXT
	item.Text = text
	item.Parent = parent
	round(item, 6)
	return item
end

-- A picture of a machine: its catalogue model seen from the front corner.
local function machinePicture(parent: Instance, def)
	local view = Instance.new("ViewportFrame")
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	view.Ambient = Color3.fromRGB(175, 175, 175)
	view.LightColor = Color3.fromRGB(255, 255, 255)
	view.LightDirection = Vector3.new(-0.5, -1, -0.7)
	local shown = if def.stages then def.stages[#def.stages] else def.icon
	ModelBuilder.build(view, CFrame.new(), shown)

	local height = math.max(def.height, 1.5)
	local centre = Vector3.new(0, -Config.CELL / 2 + height / 2, 0)
	local radius = Vector3.new(def.sx * Config.CELL, height, def.sz * Config.CELL).Magnitude / 2
	local camera = Instance.new("Camera")
	camera.FieldOfView = 20
	camera.CFrame =
		CFrame.lookAt(centre + Vector3.new(0.8, 0.7, 1).Unit * (radius / math.tan(math.rad(10))), centre)
	camera.Parent = view
	view.CurrentCamera = camera
	view.Parent = parent
end

-- Fills a picture frame for any palette entry.
local function picture(frame: Frame, entry: string)
	frame:ClearAllChildren()
	local item = Defs.itemOf(entry)
	if item then
		-- loose items: a small lump in the item's colour
		local def = Defs.Items[item]
		local lump = Instance.new("Frame")
		lump.AnchorPoint = Vector2.new(0.5, 0.5)
		lump.Position = UDim2.fromScale(0.5, 0.5)
		lump.Size = UDim2.fromScale(0.5, 0.62)
		lump.BorderSizePixel = 0
		lump.BackgroundColor3 = rgb(def.color)
		lump.Parent = frame
		round(lump, if def.ball then 100 else 5)
	elseif Defs.Blocks[entry] then
		-- blocks: the side colour with the top colour as a band above it
		local def = Defs.Blocks[entry]
		local side = Instance.new("Frame")
		side.AnchorPoint = Vector2.new(0.5, 0.5)
		side.Position = UDim2.fromScale(0.5, 0.5)
		side.Size = UDim2.fromScale(0.62, 0.78)
		side.BorderSizePixel = 0
		side.BackgroundColor3 = rgb(def.color)
		side.BackgroundTransparency = def.transparency
		side.Parent = frame
		local top = Instance.new("Frame")
		top.Size = UDim2.fromScale(1, 0.28)
		top.BorderSizePixel = 0
		top.BackgroundColor3 = rgb(def.top)
		top.BackgroundTransparency = def.transparency
		top.Parent = side
	elseif Defs.Machines[entry] then
		machinePicture(frame, Defs.Machines[entry])
	end
end

-- A tile showing one palette entry: its picture with the name underneath.
local function tile(parent: Instance, entry: string, width: number, height: number): Frame
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(width, height)
	frame.BackgroundColor3 = PANEL
	frame.BorderSizePixel = 0
	round(frame, 8)
	local stroke = Instance.new("UIStroke")
	stroke.Color = LINE
	stroke.Thickness = 1
	stroke.Parent = frame
	local art = Instance.new("Frame")
	art.Name = "Picture"
	art.BackgroundTransparency = 1
	art.Size = UDim2.new(1, 0, 1, -26)
	art.Parent = frame
	local name = label(frame, Defs.name(entry), 11)
	name.Name = "Name"
	name.Size = UDim2.new(1, -6, 0, 26)
	name.Position = UDim2.new(0, 3, 1, -27)
	picture(art, entry)
	frame.Parent = parent
	return frame
end

-- Machines that are only a model for now get a small tag saying so.
local function tagIfModelOnly(frame: Frame, entry: string)
	local def = Defs.Machines[entry]
	if def and def.behavior == "decor" then
		local tag = label(frame, "모양만", 10)
		tag.Size = UDim2.fromOffset(40, 14)
		tag.Position = UDim2.new(1, -43, 0, 3)
		tag.TextColor3 = DIM
		tag.BackgroundTransparency = 0.2
		tag.BackgroundColor3 = BACK
		round(tag, 4)
	end
end

local function redrawSlot(i: number)
	local frame = slotFrames[i]
	picture(frame:FindFirstChild("Picture") :: Frame, slots[i])
	local name = frame:FindFirstChild("Name") :: TextLabel
	name.Text = Defs.name(slots[i])
end

local function redrawSelection()
	for i, frame in slotFrames do
		local stroke = frame:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = if i == selected then PICK else LINE
		stroke.Thickness = if i == selected then 3 else 1
	end
end

function HotbarUI.selected(): string
	return slots[selected]
end

function HotbarUI.select(index: number)
	if index >= 1 and index <= #slots then
		selected = index
		redrawSelection()
	end
end

function HotbarUI.isPaletteOpen(): boolean
	return palette.Visible
end

function HotbarUI.notify(text: string)
	toastToken += 1
	local token = toastToken
	toast.Text = text
	toast.Visible = true
	task.delay(5, function()
		if token == toastToken then
			toast.Visible = false
		end
	end)
end

local function showBag(bag: { [string]: number })
	local parts = {}
	for id, count in bag do
		table.insert(parts, Stock.name(id) .. " " .. count)
	end
	table.sort(parts)
	bagLabel.Text = if #parts > 0
		then "가방: " .. table.concat(parts, "  ·  ")
		else "가방: 비어 있음"
end

local function showState(state: { mode: string, coins: number })
	stateLabel.Text = (if state.mode == "survival" then "생존" else "크리에이티브")
		.. " · "
		.. state.coins
		.. "코인"
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Shows the entries of one group in the right-hand grid.
local function showGroup(index: number)
	clear(tileGrid)
	tileGrid.CanvasPosition = Vector2.zero
	for order, entry in Defs.Palette[index].ids do
		local frame = tile(tileGrid, entry, TILE, TILE)
		frame.LayoutOrder = order
		tagIfModelOnly(frame, entry)
		local press = Instance.new("TextButton")
		press.BackgroundTransparency = 1
		press.Text = ""
		press.Size = UDim2.fromScale(1, 1)
		press.ZIndex = 5
		press.Parent = frame
		press.Activated:Connect(function()
			slots[selected] = entry
			redrawSlot(selected)
			local def = Defs.Machines[entry]
			if def and def.note ~= "" then
				HotbarUI.notify(def.name .. ": " .. def.note)
			end
		end)
	end
	for _, child in groupList:GetChildren() do
		if child:IsA("TextButton") then
			child.BackgroundColor3 = if child.LayoutOrder == index then LINE else PANEL
		end
	end
end

-- Shows the groups of one tab in the left-hand list and opens the first of them.
local function showTab(tab: string)
	currentTab = tab
	clear(groupList)
	local first: number? = nil
	for index, group in Defs.Palette do
		if group.tab == tab then
			first = first or index
			local item = button(groupList, group.name .. "  " .. #group.ids, 13)
			item.Size = UDim2.new(1, -6, 0, 30)
			item.LayoutOrder = index
			item.Activated:Connect(function()
				showGroup(index)
			end)
		end
	end
	for name, item in tabButtons do
		item.BackgroundColor3 = if name == tab then LINE else PANEL
	end
	if first then
		showGroup(first)
	end
end

function HotbarUI.togglePalette()
	palette.Visible = not palette.Visible
	if palette.Visible and #tileGrid:GetChildren() <= 1 then
		showTab(currentTab)
	end
end

local function buildPalette(gui: ScreenGui)
	palette = Instance.new("Frame")
	palette.AnchorPoint = Vector2.new(0.5, 0.5)
	palette.Position = UDim2.fromScale(0.5, 0.45)
	palette.Size = UDim2.fromOffset(760, 440)
	palette.BackgroundColor3 = BACK
	palette.BorderSizePixel = 0
	palette.Visible = false
	palette.Parent = gui
	round(palette, 12)

	local x = 14
	for _, tab in Defs.Tabs do
		local item = button(palette, tab, 15)
		item.Size = UDim2.fromOffset(90, 30)
		item.Position = UDim2.fromOffset(x, 12)
		item.Activated:Connect(function()
			showTab(tab)
		end)
		tabButtons[tab] = item
		x += 96
	end
	local title = label(palette, "고르면 지금 선택된 칸에 들어갑니다 · E로 닫기", 13)
	title.TextColor3 = DIM
	title.TextXAlignment = Enum.TextXAlignment.Right
	title.Size = UDim2.new(1, -x - 20, 0, 30)
	title.Position = UDim2.fromOffset(x, 12)

	groupList = Instance.new("ScrollingFrame")
	groupList.BackgroundTransparency = 1
	groupList.BorderSizePixel = 0
	groupList.Position = UDim2.fromOffset(14, 54)
	groupList.Size = UDim2.new(0, 170, 1, -68)
	groupList.ScrollBarThickness = 4
	groupList.CanvasSize = UDim2.new()
	groupList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	groupList.Parent = palette
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 5)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = groupList

	tileGrid = Instance.new("ScrollingFrame")
	tileGrid.BackgroundTransparency = 1
	tileGrid.BorderSizePixel = 0
	tileGrid.Position = UDim2.fromOffset(196, 54)
	tileGrid.Size = UDim2.new(1, -208, 1, -68)
	tileGrid.ScrollBarThickness = 6
	tileGrid.CanvasSize = UDim2.new()
	tileGrid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	tileGrid.Parent = palette
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(TILE, TILE)
	gridLayout.CellPadding = UDim2.fromOffset(8, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = tileGrid
end

function HotbarUI.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "FactoryUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false

	local bar = Instance.new("Frame")
	bar.BackgroundTransparency = 1
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -14)
	bar.Size = UDim2.fromOffset(#slots * (SLOT + 6), SLOT + 14)
	bar.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar

	for i, entry in slots do
		local frame = tile(bar, entry, SLOT, SLOT + 14)
		frame.LayoutOrder = i
		local number = label(frame, tostring(i), 11)
		number.Size = UDim2.fromOffset(14, 14)
		number.Position = UDim2.fromOffset(2, 0)
		number.TextColor3 = DIM
		local press = Instance.new("TextButton")
		press.BackgroundTransparency = 1
		press.Text = ""
		press.Size = UDim2.fromScale(1, 1)
		press.ZIndex = 5
		press.Parent = frame
		press.Activated:Connect(function()
			HotbarUI.select(i)
		end)
		slotFrames[i] = frame
	end

	bagLabel = label(gui, "", 14)
	bagLabel.AnchorPoint = Vector2.new(0.5, 1)
	bagLabel.Position = UDim2.new(0.5, 0, 1, -(SLOT + 36))
	bagLabel.Size = UDim2.fromOffset(900, 20)
	bagLabel.TextStrokeTransparency = 0.5

	stateLabel = label(gui, "", 14)
	stateLabel.AnchorPoint = Vector2.new(1, 0)
	stateLabel.Position = UDim2.new(1, -12, 0, 8)
	stateLabel.Size = UDim2.fromOffset(260, 20)
	stateLabel.TextXAlignment = Enum.TextXAlignment.Right
	stateLabel.TextStrokeTransparency = 0.5

	local hint = label(
		gui,
		"좌클릭 부수기 · 우클릭 놓기 · R 돌리기 · 1~9 고르기 · E 목록 · F 줍기",
		14
	)
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.new(0.5, 0, 0, 8)
	hint.Size = UDim2.fromOffset(700, 20)
	hint.TextStrokeTransparency = 0.5

	toast = label(gui, "", 15)
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.new(0.5, 0, 0, 40)
	toast.Size = UDim2.fromOffset(680, 48)
	toast.BackgroundTransparency = 0.15
	toast.BackgroundColor3 = PANEL
	toast.Visible = false
	toast.ZIndex = 10
	round(toast, 8)

	buildPalette(gui)
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	redrawSelection()
	showBag({})
	Net.get("Bag").OnClientEvent:Connect(showBag)
	Net.get("State").OnClientEvent:Connect(showState)
	Net.get("Notify").OnClientEvent:Connect(HotbarUI.notify)
end

return HotbarUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="137">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client start-up.
local StarterGui = game:GetService("StarterGui")

local HotbarUI = require(script.Parent.HotbarUI)
local BuildController = require(script.Parent.BuildController)
local DebugUI = require(script.Parent.DebugUI)

-- Roblox's own backpack bar uses the number keys; this game has its own.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- The palette draws machine models, so everything shared has to have arrived first.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

HotbarUI.init()
BuildController.init(HotbarUI)
DebugUI.init()
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="138">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-300</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>