      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">FarmLogic</string>
          <string name="Source"><![CDATA[--!strict
-- What the farm machines look for around them. The world is asked through small functions, so
-- these rules can be tested without one.
local FarmLogic = {}

export type Cell = { x: number, y: number, z: number }
type Check = (x: number, y: number, z: number) -> boolean

-- The log a logger cuts next: in the nearest trunk within `radius` cells, the highest log, so a
-- tree comes down from the top and nothing is left hanging. `below` and `above` are how many
-- cells under and over the logger's own level it looks.
function FarmLogic.nextLog(
	isLog: Check,
	cx: number,
	cy: number,
	cz: number,
	radius: number,
	below: number,
	above: number
): Cell?
	local best: Cell? = nil
	local bestDistance = math.huge
	for dx = -radius, radius do
		for dz = -radius, radius do
			local distance = dx * dx + dz * dz
			if distance > 0 and distance < bestDistance then
				for y = cy + above, cy - below, -1 do
					if isLog(cx + dx, y, cz + dz) then
						best = { x = cx + dx, y = y, z = cz + dz }
						bestDistance = distance
						break
					end
				end
			end
		end
	end
	return best
end

-- Is there still a log in this trunk, between two heights?
function FarmLogic.trunkStands(isLog: Check, x: number, z: number, yMin: number, yMax: number): boolean
	for y = yMin, yMax do
		if isLog(x, y, z) then
			return true
		end
	end
	return false
end

-- The leaves to clear once the last log of a trunk at (x, y, z) is gone: those around where the
-- tree stood that are not within reach of another trunk.
function FarmLogic.looseLeaves(isLeaf: Check, isLog: Check, x: number, y: number, z: number): { Cell }
	local found: { Cell } = {}
	for dx = -2, 2 do
		for dz = -2, 2 do
			for dy = -1, 6 do
				local lx, ly, lz = x + dx, y + dy, z + dz
				if isLeaf(lx, ly, lz) then
					local held = false
					for ox = -2, 2 do
						for oz = -2, 2 do
							for oy = -4, 1 do
								if isLog(lx + ox, ly + oy, lz + oz) then
									held = true
								end
							end
						end
					end
					if not held then
						table.insert(found, { x = lx, y = ly, z = lz })
					end
				end
			end
		end
	end
	return found
end

-- The nearest cell on the machine's own level that passes `fits`, within `radius` cells. Used for
-- the next empty plot to sow and the next ripe crop to gather. Ties go to the same cell every time.
function FarmLogic.nearest(fits: Check, cx: number, cy: number, cz: number, radius: number): Cell?
	local best: Cell? = nil
	local bestDistance = math.huge
	for dx = -radius, radius do
		for dz = -radius, radius do
			local distance = dx * dx + dz * dz
			if distance > 0 and distance < bestDistance and fits(cx + dx, cy, cz + dz) then
				best = { x = cx + dx, y = cy, z = cz + dz }
				bestDistance = distance
			end
		end
	end
	return best
end

return FarmLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--!strict
-- Grid maths. Plain numbers only, so it runs outside Roblox for tests.
local Grid = {}

-- Direction index -> step on the X and Z axes. 0 = +X, 1 = +Z, 2 = -X, 3 = -Z.
local DIRS = { { 1, 0 }, { 0, 1 }, { -1, 0 }, { 0, -1 } }

function Grid.key(x: number, y: number, z: number): string
	-- Adding zero turns negative zero into zero, so "-0" can never name a second copy of a cell.
	return (x + 0) .. "," .. (y + 0) .. "," .. (z + 0)
end

function Grid.parseKey(key: string): (number?, number?, number?)
	local xs, ys, zs = string.match(key, "^(-?%d+),(-?%d+),(-?%d+)$")
	if not xs then
		return nil, nil, nil
	end
	return tonumber(xs), tonumber(ys), tonumber(zs)
end

function Grid.isDir(d: any): boolean
	return d == 0 or d == 1 or d == 2 or d == 3
end

function Grid.rotate(d: number, turns: number): number
	return (d + turns) % 4
end

function Grid.dirVec(d: number): (number, number)
	local v = DIRS[d % 4 + 1]
	return v[1], v[2]
end

function Grid.isInt(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and math.abs(n) < 2 ^ 31
end

function Grid.inBounds(x: number, y: number, z: number, max: number): boolean
	return math.abs(x) <= max and math.abs(y) <= max and math.abs(z) <= max
end

-- World position -> the cell that contains it. Cells are centred on multiples of `cell`.
function Grid.toCell(p: number, origin: number, cell: number): number
	return math.floor((p - origin) / cell + 0.5)
end

function Grid.toWorld(c: number, origin: number, cell: number): number
	return origin + c * cell
end

-- The cells a machine of sx by sz cells covers when its anchor is at (x, z) and it faces `dir`.
-- The anchor is the machine's back-left cell; turning the machine swings the rest around it.
function Grid.footprint(x: number, z: number, dir: number, sx: number, sz: number): { { number } }
	local fx, fz = Grid.dirVec(dir)
	local rx, rz = Grid.dirVec(dir + 1)
	local cells = {}
	for i = 0, sx - 1 do
		for j = 0, sz - 1 do
			table.insert(cells, { x + i * fx + j * rx, z + i * fz + j * rz })
		end
	end
	return cells
end

-- Offset, in cells, from the anchor cell's centre to the centre of the whole footprint.
function Grid.footprintCentre(dir: number, sx: number, sz: number): (number, number)
	local fx, fz = Grid.dirVec(dir)
	local rx, rz = Grid.dirVec(dir + 1)
	local i, j = (sx - 1) / 2, (sz - 1) / 2
	return i * fx + j * rx, i * fz + j * rz
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Inventory</string>
          <string name="Source"><![CDATA[--!strict
-- A bag is a table of item id -> count. Counts are always positive whole numbers.
local Inventory = {}

export type Bag = { [string]: number }

local function isCount(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and n > 0 and n < 2 ^ 31
end

function Inventory.count(bag: Bag, id: string): number
	return bag[id] or 0
end

function Inventory.add(bag: Bag, id: string, n: number): boolean
	if not isCount(n) then
		return false
	end
	bag[id] = (bag[id] or 0) + n
	return true
end

function Inventory.remove(bag: Bag, id: string, n: number): boolean
	if not isCount(n) or (bag[id] or 0) < n then
		return false
	end
	if bag[id] == n then
		bag[id] = nil
	else
		bag[id] -= n
	end
	return true
end

-- Keeps only known ids with valid counts. Used on data read from storage.
function Inventory.sanitize(raw: any, isKnown: (string) -> boolean): Bag
	local bag: Bag = {}
	if type(raw) ~= "table" then
		return bag
	end
	for id, n in raw do
		if type(id) == "string" and isKnown(id) and isCount(n) then
			bag[id] = n
		end
	end
	return bag
end

return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">IslandGen</string>
          <string name="Source"><![CDATA[--!strict
-- The island a new player starts on: a small grassy slab with dirt and stone under it, and two trees.
local IslandGen = {}

export type Block = { x: number, y: number, z: number, id: string }

-- Radius of each layer, top first. The edge wobbles a little so the island is not a perfect disc.
local LAYERS = {
	{ y = 0, id = "grass", radius = 7.3 },
	{ y = -1, id = "dirt", radius = 6.4 },
	{ y = -2, id = "stone", radius = 5.2 },
	{ y = -3, id = "stone", radius = 3.6 },
	{ y = -4, id = "stone", radius = 2.0 },
}

local function wobble(x: number, z: number): number
	return 0.55 * math.sin(x * 1.3 + z * 0.7) + 0.35 * math.cos(z * 1.9 - x * 0.4)
end

-- A tree whose lowest log sits at (x, base, z).
function IslandGen.tree(out: { Block }, x: number, base: number, z: number, height: number)
	local top = base + height - 1
	for y = base, top do
		table.insert(out, { x = x, y = y, z = z, id = "log" })
	end
	for dy = 0, 1 do
		for dx = -1, 1 do
			for dz = -1, 1 do
				if not (dx == 0 and dz == 0 and dy == 0) then
					table.insert(out, { x = x + dx, y = top + dy, z = z + dz, id = "leaves" })
				end
			end
		end
	end
	table.insert(out, { x = x, y = top + 2, z = z, id = "leaves" })
end

function IslandGen.generate(): { Block }
	local out: { Block } = {}
	for _, layer in LAYERS do
		local reach = math.ceil(layer.radius) + 1
		for x = -reach, reach do
			for z = -reach, reach do
				if math.sqrt(x * x + z * z) + wobble(x, z) <= layer.radius then
					table.insert(out, { x = x, y = layer.y, z = z, id = layer.id })
				end
			end
		end
	end
	IslandGen.tree(out, -4, 1, -3, 3)
	IslandGen.tree(out, 4, 1, 3, 4)
	return out
end

-- Cell the player stands on when they arrive.
IslandGen.SPAWN = { x = 0, y = 1, z = 0 }

return IslandGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">ModelBuilder</string>
          <string name="Source"><![CDATA[-- Builds the look of a catalogue model out of basic parts. The server uses it for placed machines
-- and the client for the pictures in the palette. The parts are for show only: nothing collides
-- with them and the build cursor ignores them.
local Palette = require(script.Parent:WaitForChild("ModelPalette"))
local models = script.Parent:WaitForChild("Models")

local ModelBuilder = {}

local SHAPES = { [0] = Enum.PartType.Block, [1] = Enum.PartType.Cylinder, [2] = Enum.PartType.Ball }
local STRIDE = 17 -- numbers per part, see the header of any file in Models
local cache: { [string]: { number } } = {}

local function dataFor(id: string): { number }?
	local data = cache[id]
	if data then
		return data
	end
	local source = models:FindFirstChild(id)
	if not source or not source:IsA("ModuleScript") then
		return nil
	end
	data = require(source) :: { number }
	cache[id] = data
	return data
end

-- `base` is the centre of the model's footprint at the height of a cell's centre.
function ModelBuilder.build(parent: Instance, base: CFrame, id: string): Folder?
	local data = dataFor(id)
	if not data then
		return nil
	end
	local folder = Instance.new("Folder")
	folder.Name = "Visual"
	for i = 1, #data, STRIDE do
		local colour = Palette[data[i + 16] + 1]
		local part = Instance.new("Part")
		part.Shape = SHAPES[data[i]]
		part.Size = Vector3.new(data[i + 1], data[i + 2], data[i + 3])
		part.CFrame = base
			* CFrame.new(
				data[i + 4],
				data[i + 5],
				data[i + 6],
				data[i + 7],
				data[i + 8],
				data[i + 9],
				data[i + 10],
				data[i + 11],
				data[i + 12],
				data[i + 13],
				data[i + 14],
				data[i + 15]
			)
		part.Color = Color3.fromRGB(colour[1], colour[2], colour[3])
		part.Material = if colour[4] then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = folder
	end
	folder.Parent = parent
	return folder
end

return ModelBuilder
]]></string>
        </Properties>
      </Item>
