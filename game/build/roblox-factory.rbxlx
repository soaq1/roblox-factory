      <Item class="ModuleScript" referent="207">
        <Properties>
          <string name="Name">FarmLogic</string>
          <string name="Source"><![CDATA[--!strict
-- What the farm machines look for around them. The world is asked through small functions, so
-- these rules can be tested without one.
local FarmLogic = {}

export type Cell = { x: number, y: number, z: number }
type Check = (x: number, y: number, z: number) -> boolean

-- The log a logger cuts next: in the nearest trunk within `radius` cells, the highest log, so a
-- tree comes down from the top and nothing is left hanging. `below` and `above` are how many
-- cells under and over the logger's own level it looks.
function FarmLogic.nextLog(
	isLog: Check,
	cx: number,
	cy: number,
	cz: number,
	radius: number,
	below: number,
	above: number
): Cell?
	local best: Cell? = nil
	local bestDistance = math.huge
	for dx = -radius, radius do
		for dz = -radius, radius do
			local distance = dx * dx + dz * dz
			if distance > 0 and distance < bestDistance then
				for y = cy + above, cy - below, -1 do
					if isLog(cx + dx, y, cz + dz) then
						best = { x = cx + dx, y = y, z = cz + dz }
						bestDistance = distance
						break
					end
				end
			end
		end
	end
	return best
end

-- Is there still a log in this trunk, between two heights?
function FarmLogic.trunkStands(isLog: Check, x: number, z: number, yMin: number, yMax: number): boolean
	for y = yMin, yMax do
		if isLog(x, y, z) then
			return true
		end
	end
	return false
end

-- The leaves to clear once the last log of a trunk at (x, y, z) is gone: those around where the
-- tree stood that are not within reach of another trunk.
function FarmLogic.looseLeaves(isLeaf: Check, isLog: Check, x: number, y: number, z: number): { Cell }
	local found: { Cell } = {}
	for dx = -2, 2 do
		for dz = -2, 2 do
			for dy = -1, 6 do
				local lx, ly, lz = x + dx, y + dy, z + dz
				if isLeaf(lx, ly, lz) then
					local held = false
					for ox = -2, 2 do
						for oz = -2, 2 do
							for oy = -4, 1 do
								if isLog(lx + ox, ly + oy, lz + oz) then
									held = true
								end
							end
						end
					end
					if not held then
						table.insert(found, { x = lx, y = ly, z = lz })
					end
				end
			end
		end
	end
	return found
end

-- The nearest cell on the machine's own level that passes `fits`, within `radius` cells. Used for
-- the next empty plot to sow and the next ripe crop to gather. Ties go to the same cell every time.
function FarmLogic.nearest(fits: Check, cx: number, cy: number, cz: number, radius: number): Cell?
	local best: Cell? = nil
	local bestDistance = math.huge
	for dx = -radius, radius do
		for dz = -radius, radius do
			local distance = dx * dx + dz * dz
			if distance > 0 and distance < bestDistance and fits(cx + dx, cy, cz + dz) then
				best = { x = cx + dx, y = cy, z = cz + dz }
				bestDistance = distance
			end
		end
	end
	return best
end

return FarmLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--!strict
-- Grid maths. Plain numbers only, so it runs outside Roblox for tests.
local Grid = {}

-- Direction index -> step on the X and Z axes. 0 = +X, 1 = +Z, 2 = -X, 3 = -Z.
local DIRS = { { 1, 0 }, { 0, 1 }, { -1, 0 }, { 0, -1 } }

function Grid.key(x: number, y: number, z: number): string
	-- Adding zero turns negative zero into zero, so "-0" can never name a second copy of a cell.
	return (x + 0) .. "," .. (y + 0) .. "," .. (z + 0)
end

function Grid.parseKey(key: string): (number?, number?, number?)
	local xs, ys, zs = string.match(key, "^(-?%d+),(-?%d+),(-?%d+)$")
	if not xs then
		return nil, nil, nil
	end
	return tonumber(xs), tonumber(ys), tonumber(zs)
end

function Grid.isDir(d: any): boolean
	return d == 0 or d == 1 or d == 2 or d == 3
end

function Grid.rotate(d: number, turns: number): number
	return (d + turns) % 4
end

function Grid.dirVec(d: number): (number, number)
	local v = DIRS[d % 4 + 1]
	return v[1], v[2]
end

function Grid.isInt(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and math.abs(n) < 2 ^ 31
end

function Grid.inBounds(x: number, y: number, z: number, max: number): boolean
	return math.abs(x) <= max and math.abs(y) <= max and math.abs(z) <= max
end

-- World position -> the cell that contains it. Cells are centred on multiples of `cell`.
function Grid.toCell(p: number, origin: number, cell: number): number
	return math.floor((p - origin) / cell + 0.5)
end

function Grid.toWorld(c: number, origin: number, cell: number): number
	return origin + c * cell
end

-- The cells a machine of sx by sz cells covers when its anchor is at (x, z) and it faces `dir`.
-- The anchor is the machine's back-left cell; turning the machine swings the rest around it.
function Grid.footprint(x: number, z: number, dir: number, sx: number, sz: number): { { number } }
	local fx, fz = Grid.dirVec(dir)
	local rx, rz = Grid.dirVec(dir + 1)
	local cells = {}
	for i = 0, sx - 1 do
		for j = 0, sz - 1 do
			table.insert(cells, { x + i * fx + j * rx, z + i * fz + j * rz })
		end
	end
	return cells
end

-- Offset, in cells, from the anchor cell's centre to the centre of the whole footprint.
function Grid.footprintCentre(dir: number, sx: number, sz: number): (number, number)
	local fx, fz = Grid.dirVec(dir)
	local rx, rz = Grid.dirVec(dir + 1)
	local i, j = (sx - 1) / 2, (sz - 1) / 2
	return i * fx + j * rx, i * fz + j * rz
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="209">
        <Properties>
          <string name="Name">HandLogic</string>
          <string name="Source"><![CDATA[--!nocheck
-- What the hand can do with the thing it holds, apart from swinging a tool (that is ToolLogic):
-- which loose item a held thing is let go as, which slot a thing looked at belongs in, which way
-- a dragged belt faces, and how to tell which block a placed part is from the way it looks.
-- Definitions and the bag rules are passed in, so this runs outside Roblox.
local HandLogic = {}

-- The loose item that Q lets go of for a hotbar entry, or nil if the entry has no loose form.
-- An "item:<id>" entry is that item. A block that is also an item (log, stone, ore), or that is
-- laid from one (dirt from a clod), is let go as that item; so is a plant, as its seed. In
-- survival the bag must hold it; `free` is creative mode.
function HandLogic.looseForm(Defs, Stock, entry: string, bag: { [string]: number }, free: boolean): string?
	local item = Defs.itemOf(entry)
	if item then
		return item
	end
	local first: string? = nil
	for _, key in Stock.placeCost(entry) do
		if Defs.Items[key] then
			if (bag[key] or 0) >= 1 then
				return key
			end
			first = first or key
		end
	end
	return if free then first else nil
end

-- Can the bag pay for placing this entry? Everything is to hand in creative mode.
function HandLogic.canSupply(Stock, entry: string, bag: { [string]: number }, free: boolean): boolean
	if free then
		return true
	end
	for _, key in Stock.placeCost(entry) do
		if (bag[key] or 0) >= 1 then
			return true
		end
	end
	return false
end

-- Where the thing looked at goes: the slot that already holds it ("select"), else the current
-- slot if the bag can supply it ("assign"), else nowhere ("none").
function HandLogic.pick(
	Stock,
	slots: { string },
	entry: string,
	bag: { [string]: number },
	free: boolean
): (string, number?)
	local index = table.find(slots, entry)
	if index then
		return "select", index
	end
	if HandLogic.canSupply(Stock, entry, bag, free) then
		return "assign", nil
	end
	return "none", nil
end

-- The facing (0..3 = +X, +Z, -X, -Z) of a belt laid one cell further along a drag, or nil when
-- the step is not to a cell straight ahead, behind or beside on the same level.
function HandLogic.dragDir(dx: number, dy: number, dz: number): number?
	if dy ~= 0 or math.abs(dx) + math.abs(dz) ~= 1 then
		return nil
	end
	if dx == 1 then
		return 0
	elseif dz == 1 then
		return 1
	elseif dx == -1 then
		return 2
	end
	return 3
end

-- A block is drawn with a thin cap when its top differs enough from its sides. (The same test
-- the server uses when it builds the block.)
local function capOf(def): { number }?
	local c, t = def.color, def.top
	if math.abs(t[1] - c[1]) + math.abs(t[2] - c[2]) + math.abs(t[3] - c[3]) > 60 then
		return t
	end
	return nil
end

local function same(a: { number }?, b: { number }?): boolean
	if not a or not b then
		return a == b
	end
	return a[1] == b[1] and a[2] == b[2] and a[3] == b[3]
end

-- Which block a placed part is, told from its side colour and its cap (nil if it has none).
-- Placed blocks carry no name, so their look is all there is to go on.
function HandLogic.blockByLook(Defs, side: { number }, cap: { number }?): string?
	local ids = {}
	for id in Defs.Blocks do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		local def = Defs.Blocks[id]
		if same(def.color, side) and same(capOf(def), cap) then
			return id
		end
	end
	return nil
end

-- The cells a machine placed at (x, y, z) covers, as "x,y,z" keys given by `keyOf`.
function HandLogic.covered(Grid, def, x: number, y: number, z: number, dir: number): { string }
	local keys = {}
	for layer = 0, (def.sy or 1) - 1 do
		for _, cell in Grid.footprint(x, z, dir, def.sx or 1, def.sz or 1) do
			table.insert(keys, Grid.key(cell[1], y + layer, cell[2]))
		end
	end
	return keys
end

-- Where a belt's things come in and go out, in the same form as a machine's ports. Belts have
-- none listed because nothing is swallowed, but the outline still shows which way they carry.
function HandLogic.beltPorts(shape: string?): { { side: string, kind: string, off: number } }
	local out = if shape == "right" then "S" elseif shape == "left" then "N" else "E"
	return { { side = "W", kind = "in", off = 0 }, { side = out, kind = "out", off = 0 } }
end

return HandLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="210">
        <Properties>
          <string name="Name">Inventory</string>
          <string name="Source"><![CDATA[--!strict
-- A bag is a table of item id -> count. Counts are always positive whole numbers.
local Inventory = {}

export type Bag = { [string]: number }

local function isCount(n: any): boolean
	return type(n) == "number" and n == n and n % 1 == 0 and n > 0 and n < 2 ^ 31
end

function Inventory.count(bag: Bag, id: string): number
	return bag[id] or 0
end

function Inventory.add(bag: Bag, id: string, n: number): boolean
	if not isCount(n) then
		return false
	end
	bag[id] = (bag[id] or 0) + n
	return true
end

function Inventory.remove(bag: Bag, id: string, n: number): boolean
	if not isCount(n) or (bag[id] or 0) < n then
		return false
	end
	if bag[id] == n then
		bag[id] = nil
	else
		bag[id] -= n
	end
	return true
end

-- Keeps only known ids with valid counts. Used on data read from storage.
function Inventory.sanitize(raw: any, isKnown: (string) -> boolean): Bag
	local bag: Bag = {}
	if type(raw) ~= "table" then
		return bag
	end
	for id, n in raw do
		if type(id) == "string" and isKnown(id) and isCount(n) then
			bag[id] = n
		end
	end
	return bag
end

return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">IslandGen</string>
          <string name="Source"><![CDATA[--!strict
-- The island a new player starts on: a small grassy slab with dirt and stone under it, and two trees.
local IslandGen = {}

export type Block = { x: number, y: number, z: number, id: string }

-- Radius of each layer, top first. The edge wobbles a little so the island is not a perfect disc.
local LAYERS = {
	{ y = 0, id = "grass", radius = 7.3 },
	{ y = -1, id = "dirt", radius = 6.4 },
	{ y = -2, id = "stone", radius = 5.2 },
	{ y = -3, id = "stone", radius = 3.6 },
	{ y = -4, id = "stone", radius = 2.0 },
}

local function wobble(x: number, z: number): number
	return 0.55 * math.sin(x * 1.3 + z * 0.7) + 0.35 * math.cos(z * 1.9 - x * 0.4)
end

function IslandGen.generate(): { Block }
	local out: { Block } = {}
	for _, layer in LAYERS do
		local reach = math.ceil(layer.radius) + 1
		for x = -reach, reach do
			for z = -reach, reach do
				if math.sqrt(x * x + z * z) + wobble(x, z) <= layer.radius then
					table.insert(out, { x = x, y = layer.y, z = z, id = layer.id })
				end
			end
		end
	end
	return out
end

-- Where the island's first trees stand. They are grown things, not blocks.
IslandGen.TREES = { { x = -4, y = 1, z = -3 }, { x = 4, y = 1, z = 3 } }

-- Cell the player stands on when they arrive.
IslandGen.SPAWN = { x = 0, y = 1, z = 0 }

return IslandGen
]]></string>
        </Properties>
      </Item>
