            <string name="Name">assembler</string>
            <string name="Source"><![CDATA[-- Generated by game/tools/gen_data.py. Do not edit by hand.
--!nocheck
-- 17 numbers per part: shape (0 block, 1 cylinder, 2 ball), size x y z, position x y z,
